    tb.innerHTML=`
      <table class="block-table">
        <thead><tr><th>R₁ ± ΔR₁ (KΩ)</th><th>R₂ ± ΔR₂ (KΩ)</th><th>R₃ ± ΔR₃ (KΩ)</th><th>R<sub>C</sub> ± ΔR<sub>C</sub> (KΩ)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r1Str" value="${r.r1Str}"> <span class="auto">± ${fmtAutoDelta(c.dr1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r2Str" value="${r.r2Str}"> <span class="auto">± ${fmtAutoDelta(c.dr2)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r3Str" value="${r.r3Str}"> <span class="auto">± ${fmtAutoDelta(c.dr3)}</span></td>
