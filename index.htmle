        <div class="color-row glass-inset" style="padding:14px;border-radius:16px">
          <div style="font-weight:800;margin-bottom:8px;color:#e9fbff">R — رنگ نوارها</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <label style="font-size:11px;color:#9fb0c9">۱<select data-exp6-r="1" data-band="b1"></select></label>
            <label style="font-size:11px;color:#9fb0c9">۲<select data-exp6-r="1" data-band="b2"></select></label>
            <label style="font-size:11px;color:#9fb0c9">۳<select data-exp6-r="1" data-band="b3"></select></label>
            <span class="chip" style="font-size:11px">طلایی ±۵٪</span>
          </div>
