      <div class="lab-tables" id="exp4TableBody"></div>
    </section>

    <section class="panel glass"><div class="section-head"><div><h2>فرمول‌ها، جایگذاری و نتیجه — آزمایش ۴</h2></div></div><div class="calc-grid" id="exp4Cards"></div></section>
