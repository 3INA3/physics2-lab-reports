<title>آزمایشگاه فیزیک ۲ | گزارش کار کامل · © سینا شجاعیان · SS-PHYS2-F222-9D2F-2026-FULL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#030712;
    --text:#f0f7ff;
    --muted:#93a4c3;
    --cyan:#22d3ee;
    --cyan2:#67e8f9;
    --violet:#a78bfa;
    --violet2:#c4b5fd;
    --gold:#fbbf24;
    --pink:#f472b6;
    --green:#34d399;
    --stroke: rgba(255,255,255,.14);
    --stroke-bright: rgba(103,232,249,.35);
    --shadow: 0 30px 80px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.04);
    --glow-cyan: 0 0 40px rgba(34,211,238,.25);
    --glow-violet: 0 0 40px rgba(167,139,250,.22);
  }
  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0; min-height:100vh; color:var(--text);
    font-family:'Vazirmatn','Segoe UI',Tahoma,sans-serif; overflow-x:hidden;
    background:
      radial-gradient(ellipse 900px 500px at 10% -5%, rgba(56,189,248,.28) 0%, transparent 55%),
      radial-gradient(ellipse 700px 480px at 95% 5%, rgba(139,92,246,.30) 0%, transparent 50%),
      radial-gradient(ellipse 600px 400px at 50% 100%, rgba(244,114,182,.12) 0%, transparent 45%),
      radial-gradient(ellipse 500px 300px at 70% 60%, rgba(52,211,153,.08) 0%, transparent 40%),
      linear-gradient(160deg, #020617 0%, #0a0f1f 40%, #050b18 100%);
  }
  .bg-grid{
    position:fixed; inset:0; pointer-events:none; z-index:0;
    background-image:
      linear-gradient(rgba(34,211,238,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(167,139,250,.04) 1px, transparent 1px);
    background-size:56px 56px;
    mask-image:radial-gradient(ellipse at 50% 30%, black 0%, transparent 75%);
    -webkit-mask-image:radial-gradient(ellipse at 50% 30%, black 0%, transparent 75%);
    animation:gridDrift 40s linear infinite;
  }
  @keyframes gridDrift{ from{ background-position:0 0; } to{ background-position:56px 56px; } }
  .orb{ position:fixed; border-radius:50%; filter:blur(48px); opacity:.5; pointer-events:none; z-index:0; animation:floatOrb 16s ease-in-out infinite; }
  .orb.one{ width:320px; height:320px; background:radial-gradient(circle,#38bdf8,#2563eb); top:4%; left:2%; }
  .orb.two{ width:280px; height:280px; background:radial-gradient(circle,#a78bfa,#7c3aed); top:20%; right:0; animation-delay:-5s; }
  .orb.three{ width:240px; height:240px; background:radial-gradient(circle,#f472b6,#db2777); bottom:5%; left:30%; animation-delay:-9s; opacity:.35; }
  @keyframes floatOrb{
    0%,100%{ transform:translate3d(0,0,0) scale(1); }
    33%{ transform:translate3d(24px,-30px,0) scale(1.1); }
    66%{ transform:translate3d(-16px,18px,0) scale(.95); }
  }
  .glass{
    position:relative;
    background:
      linear-gradient(145deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,.05) 40%, rgba(255,255,255,.03) 100%);
    border:1px solid rgba(255,255,255,.16);
    border-radius:26px;
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255,255,255,.28),
      inset 0 -1px 0 rgba(0,0,0,.15);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .3s ease;
  }
  .glass::before{
    content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none;
    background:linear-gradient(135deg, rgba(34,211,238,.08), transparent 40%, rgba(167,139,250,.06));
    opacity:.9;
  }
  .panel.glass:hover{
    border-color:rgba(103,232,249,.28);
    box-shadow: var(--shadow), var(--glow-cyan), inset 0 1px 0 rgba(255,255,255,.3);
  }
  .glass-inset{ background:linear-gradient(135deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); border:1px solid rgba(255,255,255,.1);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12), 0 12px 30px rgba(0,0,0,.22); border-radius:20px; }
  .shell{ position:relative; z-index:2; width:min(1480px, calc(100% - 28px)); margin:0 auto; padding:24px 0 60px; }
  .hero{ position:relative; overflow:hidden; padding:30px 30px 26px; }
  .hero-top{ display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap; position:relative; z-index:2; }
  .eyebrow{ display:inline-flex; align-items:center; gap:8px; padding:8px 13px; border-radius:999px; color:#c8f6ff; background:rgba(97,231,255,.09); border:1px solid rgba(97,231,255,.22); font-size:12px; box-shadow:inset 0 1px 0 rgba(255,255,255,.16); }
  .eyebrow .dot{ width:8px;height:8px;border-radius:50%; background:var(--cyan); box-shadow:0 0 12px var(--cyan),0 0 24px var(--cyan); animation:pulse 2s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{ transform:scale(1); opacity:1; } 50%{ transform:scale(1.35); opacity:.6; } }
  h1{ margin:14px 0 8px; font-size:clamp(22px, 3vw, 38px); line-height:1.15; font-weight:800; letter-spacing:-1px; }
  .gradient-text{ background:linear-gradient(90deg, #dffaff, #61e7ff 35%, #a78bfa 70%, #f6c453); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero p{ margin:0; max-width:850px; color:var(--muted); line-height:2; font-size:14px; }
  .hero-actions{ display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; position:relative; z-index:2; }
  .btn{
    background:linear-gradient(135deg, rgba(34,211,238,.3), rgba(167,139,250,.28));
    border:1px solid rgba(103,232,249,.4); color:#fff;
    padding:10px 18px; border-radius:14px; font-family:inherit; font-weight:700; font-size:13px;
    cursor:pointer; position:relative; overflow:hidden;
    box-shadow:0 10px 28px rgba(34,211,238,.18), inset 0 1px 0 rgba(255,255,255,.2);
    transition:transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease, filter .2s ease;
  }
  .btn:hover{ filter:brightness(1.12); transform:translateY(-2px); box-shadow:0 14px 34px rgba(34,211,238,.28); }
  .btn:active{ transform:translateY(0); }
  .btn:hover{ transform:translateY(-2px); border-color:rgba(97,231,255,.45); box-shadow:0 18px 38px rgba(0,0,0,.3), 0 0 0 4px rgba(97,231,255,.06), inset 0 1px 0 rgba(255,255,255,.3); }
  .btn.primary{ background:linear-gradient(135deg, rgba(97,231,255,.24), rgba(167,139,250,.24)); border-color:rgba(97,231,255,.45); }
  .btn.print-btn{ background:linear-gradient(135deg, rgba(246,196,83,.24), rgba(251,113,133,.18)); border-color:rgba(246,196,83,.45); }
  .btn.mini{ padding:8px 13px; font-size:12.5px; border-radius:10px; }
  .tabs{ display:flex; gap:8px; margin:22px 0 0; flex-wrap:wrap; padding:7px; background:rgba(5,12,28,.55); border:1px solid rgba(255,255,255,.1); border-radius:18px; box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 14px 34px rgba(0,0,0,.3); }
  .tab-btn{
    flex:1; min-width:150px; padding:12px 12px; background:transparent;
    border:1px solid transparent; border-radius:14px; color:#94a8c7;
    font-family:inherit; font-size:12.5px; font-weight:700; cursor:pointer;
    transition:all .3s cubic-bezier(.2,.8,.2,1);
    display:flex; align-items:center; justify-content:center; gap:8px;
    position:relative; overflow:hidden;
  }
  .tab-btn::after{
    content:''; position:absolute; inset:0; background:linear-gradient(120deg, transparent, rgba(255,255,255,.08), transparent);
    transform:translateX(-120%); transition:transform .5s ease;
  }
  .tab-btn:hover{ background:rgba(34,211,238,.08); color:#e0f2fe; border-color:rgba(34,211,238,.18); transform:translateY(-1px); }
  .tab-btn:hover::after{ transform:translateX(120%); }
  .tab-btn.active{
    background:linear-gradient(135deg, rgba(34,211,238,.28), rgba(167,139,250,.26));
    border-color:rgba(103,232,249,.45); color:#fff;
    box-shadow:0 12px 32px rgba(34,211,238,.22), 0 0 0 1px rgba(167,139,250,.15), inset 0 1px 0 rgba(255,255,255,.2);
    transform:translateY(-2px);
  }
  .tab-num{ width:26px; height:26px; border-radius:8px; background:rgba(97,231,255,.14); border:1px solid rgba(97,231,255,.3); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; }
  .tab-btn.active .tab-num{ background:rgba(97,231,255,.32); }
  .tab-panel{ display:none; } .tab-panel.active{ display:block; animation:fadeIn .35s ease; }
  @keyframes fadeIn{ from{ opacity:0; transform:translateY(8px);} to{ opacity:1; transform:translateY(0);} }
  .panel{ margin-top:22px; padding:24px; }
  .section-head{ display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:18px; }
  .section-head h2{ margin:0; font-size:19px; font-weight:800; letter-spacing:-.2px; }
  .section-head .hint{ color:var(--muted); font-size:13px; line-height:1.8; margin-top:4px; }
  .chips{ display:flex; flex-wrap:wrap; gap:8px; }
  .chip{
    display:inline-flex; align-items:center; gap:6px;
    padding:5px 12px; border-radius:999px; font-size:11.5px; font-weight:700;
    background:linear-gradient(135deg, rgba(34,211,238,.14), rgba(167,139,250,.12));
    border:1px solid rgba(103,232,249,.28); color:#dffcff;
    box-shadow:0 4px 14px rgba(34,211,238,.1), inset 0 1px 0 rgba(255,255,255,.12);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .chip:hover{ transform:translateY(-1px) scale(1.03); box-shadow:0 6px 18px rgba(34,211,238,.2); }
  .simple-circuit-wrap{ display:grid; grid-template-columns: 1.4fr 1fr; gap:22px; align-items:center; padding:18px; border-radius:24px;
    background: radial-gradient(circle at 50% 20%, rgba(97,231,255,.1), transparent 45%), linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.015));
    border:1px solid rgba(255,255,255,.09); }
  .simple-circuit-stage{ position:relative; display:flex; align-items:center; justify-content:center; min-height:300px; padding:16px; }
  .simple-circuit-svg{ width:100%; max-width:520px; height:auto; filter: drop-shadow(0 18px 30px rgba(0,0,0,.5)); }
  .simple-circuit-info{ display:flex; flex-direction:column; gap:10px; padding:14px; }
  .simple-circuit-info .info-title{ font-size:14px; font-weight:800; color:#e9fbff; margin-bottom:4px; display:flex; align-items:center; gap:8px; }
  .simple-circuit-info .info-title::before{ content:""; width:8px; height:8px; border-radius:50%; background:var(--cyan); box-shadow:0 0 10px var(--cyan); }
  .simple-circuit-info .info-row{ display:flex; align-items:flex-start; gap:10px; padding:9px 12px; border-radius:10px; background:rgba(3,8,20,.35); border:1px solid rgba(255,255,255,.06); font-size:12.5px; line-height:1.7; color:#cfdaea; }
  .simple-circuit-info .info-row b{ color:var(--cyan); font-family:'Courier New',monospace; font-weight:800; min-width:44px; display:inline-block; }
  .instructions-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(290px, 1fr)); gap:14px; }
  .instruction-card{ padding:20px 18px 18px; position:relative; overflow:hidden; border-radius:20px; transition:transform .35s cubic-bezier(.22,1,.36,1), box-shadow .3s ease; transform-style:preserve-3d; }
  .instruction-card::before{ content:""; position:absolute; width:120px; height:120px; top:-40px; left:-40px; border-radius:50%; background:radial-gradient(circle, rgba(97,231,255,.14), transparent 70%); pointer-events:none; }
  .instruction-num{ position:absolute; top:14px; left:14px; width:36px; height:36px; border-radius:11px; background:linear-gradient(135deg, rgba(97,231,255,.24), rgba(167,139,250,.24)); border:1px solid rgba(97,231,255,.32); display:flex; align-items:center; justify-content:center; font-weight:800; color:#e9fbff; font-size:16px; z-index:1; }
  .instruction-card h3{ margin:0 0 12px; padding-left:48px; font-size:15px; color:#fff; font-weight:800; position:relative; z-index:1; }
  .instruction-card p{ margin:0 0 10px; font-size:13px; line-height:2; color:#cfdaea; position:relative; z-index:1; }
  .instruction-card ol, .instruction-card ul{ margin:8px 0; padding-right:20px; font-size:13px; line-height:2; color:#cfdaea; position:relative; z-index:1; }
  .instruction-card li{ margin-bottom:5px; }
  .instruction-card code{ background:rgba(97,231,255,.1); color:#a5f3fc; padding:2px 7px; border-radius:6px; font-family:'Courier New',monospace; font-size:12px; direction:ltr; display:inline-block; border:1px solid rgba(97,231,255,.18); }
  .instruction-card .warn{ background:rgba(251,113,133,.1); border-right:3px solid #fb7185; padding:9px 12px; border-radius:8px; font-size:12.5px; color:#fecdd3; margin-top:12px; position:relative; z-index:1; line-height:1.9; }
  .instruction-card .note{ background:rgba(246,196,83,.08); border-right:3px solid var(--gold); padding:9px 12px; border-radius:8px; font-size:12.5px; color:#fde8b3; margin-top:12px; position:relative; z-index:1; line-height:1.9; }
  .instruction-card .info{ background:rgba(97,231,255,.08); border-right:3px solid var(--cyan); padding:9px 12px; border-radius:8px; font-size:12.5px; color:#c8f6ff; margin-top:12px; position:relative; z-index:1; line-height:1.9; }
  .circuit-wrap{ padding:22px 18px 16px; display:flex; flex-direction:column; align-items:center; gap:14px; position:relative; overflow:hidden; border-radius:20px; }
  .circuit-stage{ width:100%; max-width:980px; height:540px; perspective:1600px; perspective-origin:50% 50%; display:flex; align-items:center; justify-content:center; position:relative; cursor:grab; touch-action:none; user-select:none; }
  .circuit-stage:active{ cursor:grabbing; }
  .circuit-3d{ width:min(880px, 96%); aspect-ratio: 800 / 500; transform-style:preserve-3d; will-change:transform; filter: drop-shadow(0 26px 40px rgba(0,0,0,.55)); position:relative; transition:transform .05s linear; }
  .circuit-3d svg{ width:100%; height:100%; overflow:visible; display:block; }
  .circuit-controls{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:center; position:relative; z-index:1; }
  .circuit-hint{ color:#93a7c2; font-size:12px; line-height:1.9; }
  .legend{ display:flex; flex-wrap:wrap; gap:6px; justify-content:center; position:relative; z-index:1; max-width:980px; }
  .legend .chip{ background:rgba(255,255,255,.045); border-color:rgba(255,255,255,.09); font-size:11.5px; padding:5px 10px; }
  .legend .chip b{ color:var(--cyan); font-family:'Courier New',monospace; margin-left:4px; font-size:12px; }
  .readout{ position:absolute; top:18px; left:18px; display:flex; flex-direction:column; gap:8px; padding:12px 14px; background:linear-gradient(135deg, rgba(5,12,28,.85), rgba(5,12,28,.6)); border:1px solid rgba(97,231,255,.3); border-radius:14px; backdrop-filter: blur(14px); box-shadow:0 10px 30px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.1); z-index:3; min-width:170px; font-variant-numeric:tabular-nums; }
  .readout-title{ font-size:11px; color:#8ee9ff; font-weight:700; letter-spacing:.5px; border-bottom:1px solid rgba(97,231,255,.2); padding-bottom:6px; margin-bottom:2px; display:flex; align-items:center; gap:6px; }
  .readout-title::before{ content:"●"; color:#61e7ff; font-size:8px; animation:pulse 1.5s ease-in-out infinite; }
  .readout-row{ display:flex; justify-content:space-between; align-items:baseline; gap:12px; font-size:12.5px; }
  .readout-label{ color:#a5b8d1; font-family:'Courier New',monospace; font-weight:700; letter-spacing:.4px; }
  .readout-val{ color:#dffcff; font-weight:800; direction:ltr; font-family:'Courier New',monospace; font-size:13px; }
  .readout-val .pm{ color:#8ee9ff; font-weight:600; font-size:11px; margin-right:4px; }
  .resistor-gallery{ display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:18px; perspective:1600px; perspective-origin:50% 40%; padding:14px 4px 24px; overflow:visible; }
  .resistor-card{ position:relative; padding:28px 16px 18px; border-radius:22px;
    background: radial-gradient(circle at 50% 0%, rgba(97,231,255,.08), transparent 55%), linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015));
    border:1px solid rgba(255,255,255,.1); box-shadow:0 12px 30px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.1);
    transform-style:preserve-3d; transition:transform .45s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease; cursor:pointer; overflow:visible; user-select:none; will-change:transform; }
  .resistor-card::before{ content:""; position:absolute; inset:0; border-radius:inherit; background:radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(97,231,255,.2), transparent 45%); opacity:0; transition:opacity .3s ease; pointer-events:none; z-index:1; }
  .resistor-card:hover::before, .resistor-card.active::before{ opacity:1; }
  .resistor-card:hover{ border-color:rgba(97,231,255,.3); box-shadow:0 20px 42px rgba(0,0,0,.42), 0 0 0 1px rgba(97,231,255,.15), inset 0 1px 0 rgba(255,255,255,.15); }
  .resistor-card.active{ border-color:rgba(97,231,255,.55); box-shadow:0 20px 48px rgba(97,231,255,.22), 0 0 0 1px rgba(97,231,255,.35), inset 0 1px 0 rgba(255,255,255,.18); }
  .resistor-card.active::after{ content:""; position:absolute; inset:-2px; border-radius:24px; background:linear-gradient(135deg, rgba(97,231,255,.55), rgba(167,139,250,.45)); z-index:-1; filter:blur(8px); opacity:.55; pointer-events:none; }
  .resistor-card .resistor-3d{ position:relative; width:100%; max-width:220px; height:96px; direction:ltr; margin:0 auto; transform-style:preserve-3d; transition:transform .35s cubic-bezier(.22,1,.36,1); z-index:2; }
  .resistor-card .lead{ position:absolute; top:50%; height:7px; width:14%; transform:translateY(-50%); background:linear-gradient(180deg,#e8f0fa 0%,#94a3b8 45%,#1e293b 100%); box-shadow:0 2px 4px rgba(0,0,0,.5); border-radius:999px; z-index:1; }
  .resistor-card .lead.left{ left:0; }
  .resistor-card .lead.right{ right:0; }
  .resistor-card .resistor-body{ position:absolute; left:13%; right:13%; top:22px; height:52px; border-radius:999px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.55) 18%, rgba(255,255,255,.15) 32%, rgba(0,0,0,0) 45%, rgba(0,0,0,.15) 65%, rgba(0,0,0,.5) 92%, rgba(0,0,0,.7) 100%),
      linear-gradient(180deg,#f7e3ba 0%, #d9b580 22%, #b07f4a 55%, #6d3d1e 88%, #3d1f0a 100%);
    box-shadow: 0 12px 22px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.55), inset 0 -8px 14px rgba(0,0,0,.35); z-index:2; }
  .resistor-card .resistor-body::before{ content:""; position:absolute; left:0; right:0; top:8px; height:12px; border-radius:999px; background:linear-gradient(180deg, rgba(255,255,255,.5), transparent); opacity:.55; pointer-events:none; }
  .resistor-card .resistor-body::after{ content:""; position:absolute; inset:0; border-radius:999px; background:linear-gradient(90deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 8%, rgba(0,0,0,0) 92%, rgba(0,0,0,.5) 100%); pointer-events:none; }
  .resistor-card .band{ position:absolute; top:0; bottom:0; width:14px; border-radius:4px; background:#e63946; box-shadow:0 0 12px currentColor, inset 0 0 6px rgba(0,0,0,.4); z-index:3; overflow:hidden; transition:background .3s ease, color .3s ease, box-shadow .3s ease; }
  .resistor-card .band::after{ content:""; position:absolute; inset:0; background:linear-gradient(90deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 25%, rgba(255,255,255,.4) 50%, rgba(0,0,0,0) 75%, rgba(0,0,0,.5) 100%); pointer-events:none; }
  .resistor-card .band[data-band="1"] { left:20%; } .resistor-card .band[data-band="2"] { left:36%; }
  .resistor-card .band[data-band="3"] { left:52%; } .resistor-card .band.tol { right:10%; }
  .resistor-card .resistor-3d::after{ content:""; position:absolute; bottom:-10px; left:22%; right:22%; height:12px; background:radial-gradient(ellipse, rgba(0,0,0,.6), transparent 70%); filter:blur(5px); pointer-events:none; transform:translateZ(-15px); }
  .card-label{ font-size:15px; font-weight:800; color:#e9fbff; text-align:center; margin-top:14px; position:relative; z-index:2; letter-spacing:.5px; }
  .card-info{ font-size:11.5px; color:#8fa2ba; text-align:center; margin-top:4px; position:relative; z-index:2; min-height:16px; line-height:1.7; }
  .card-rc{ font-family:'Courier New',monospace; font-weight:800; color:#dffcff; font-size:12.5px; direction:ltr; text-align:center; margin-top:8px; position:relative; z-index:2; background:rgba(3,8,20,.5); padding:5px 10px; border-radius:8px; border:1px solid rgba(97,231,255,.15); display:inline-block; }
  .color-controls{ display:grid; gap:10px; }
  .color-row{ display:grid; grid-template-columns:70px repeat(3, minmax(130px, 1fr)) minmax(150px, .9fr); gap:10px; align-items:center; padding:11px 13px; border-radius:18px;
    background:linear-gradient(135deg, rgba(255,255,255,.055), rgba(255,255,255,.018)); border:1px solid rgba(255,255,255,.085); box-shadow:inset 0 1px 0 rgba(255,255,255,.08); }
  .color-tag{ display:flex; align-items:center; justify-content:center; height:38px; border-radius:12px; background:linear-gradient(135deg, rgba(97,231,255,.17), rgba(167,139,250,.17)); border:1px solid rgba(97,231,255,.22); font-weight:800; color:#e9fbff; font-size:14px; }
  .select-label{ display:flex; flex-direction:column; gap:6px; font-size:11px; color:#a8bbd4; }
  .select-wrap{ display:flex; align-items:center; gap:8px; }
  .swatch{ flex:0 0 auto; width:18px; height:18px; border-radius:50%; border:1px solid rgba(255,255,255,.45); box-shadow:0 0 14px currentColor, inset 0 1px 0 rgba(255,255,255,.45); background:#e63946; }
  select, input{ font-family:inherit; }
  select{ width:100%; min-width:0; appearance:none; -webkit-appearance:none;
    background: linear-gradient(45deg, transparent 50%, #93a7c2 50%) calc(100% - 16px) 50% / 6px 6px no-repeat, linear-gradient(135deg, #93a7c2 50%, transparent 50%) calc(100% - 11px) 50% / 6px 6px no-repeat, rgba(3,8,20,.5);
    border:1px solid rgba(255,255,255,.13); border-radius:11px; color:var(--text); padding:9px 28px 9px 10px; font-size:13px; outline:none; }
  select:focus{ border-color:rgba(97,231,255,.55); box-shadow:0 0 0 3px rgba(97,231,255,.12); }
  .fixed-tol{ font-size:12px; color:#b9c9dd; line-height:1.8; text-align:left; direction:ltr; }
  .fixed-tol strong{ color:var(--gold); white-space:nowrap; }
  .table-wrap{ width:100%; overflow:auto; border-radius:22px; padding-bottom:4px; }
  table{ width:100%; min-width:0; border-collapse:separate; border-spacing:0 10px; }
  thead th{ position:sticky; top:0; z-index:3; padding:12px 9px; color:#b8c9df; font-size:12px; font-weight:700; text-align:center;
    background:rgba(5,12,28,.75); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-top:1px solid rgba(255,255,255,.08); border-bottom:1px solid rgba(255,255,255,.08); }
  thead th:first-child{ border-radius:0 14px 14px 0; } thead th:last-child{ border-radius:14px 0 0 14px; }
  thead small{ display:block; margin-top:3px; color:#7f93ad; font-size:10px; font-weight:400; }
  tbody tr{ background:linear-gradient(90deg, rgba(255,255,255,.075), rgba(255,255,255,.025)); box-shadow:inset 0 0 0 1px rgba(255,255,255,.07), 0 10px 24px rgba(0,0,0,.16); transition:transform .2s ease, box-shadow .2s ease, background .2s ease; }
  tbody tr:hover{ transform:translateY(-2px); background:linear-gradient(90deg, rgba(97,231,255,.08), rgba(255,255,255,.025)); box-shadow:inset 0 0 0 1px rgba(97,231,255,.17), 0 16px 34px rgba(0,0,0,.22); }
  tbody tr.active{ background:linear-gradient(90deg, rgba(97,231,255,.12), rgba(167,139,250,.055)); box-shadow:inset 0 0 0 1px rgba(97,231,255,.26), 0 16px 34px rgba(0,0,0,.22); }
  td{ padding:11px 9px; text-align:center; border-top:1px solid rgba(255,255,255,.055); border-bottom:1px solid rgba(255,255,255,.055); }
  td:first-child{ border-radius:0 16px 16px 0; } td:last-child{ border-radius:16px 0 0 16px; }
  .row-head{ min-width:112px; }
  .row-pick{ appearance:none; border:0; background:transparent; color:#e9fbff; font-family:inherit; font-weight:800; font-size:14px; cursor:pointer; padding:2px 8px; border-radius:8px; }
  .row-pick:hover{ background:rgba(97,231,255,.1); }
  .mini-bands{ display:flex; justify-content:center; gap:3px; margin-top:7px; }
  .band-dot{ width:13px; height:19px; border-radius:4px; display:inline-block; border:1px solid rgba(255,255,255,.2); box-shadow:inset 0 0 6px rgba(0,0,0,.35), 0 0 8px currentColor; }
  td.num{ direction:ltr; font-variant-numeric:tabular-nums; color:#e7f1ff; font-size:13px; white-space:nowrap; }
  td.num.strong{ color:#fff; font-weight:800; }
  td.num.result{ color:#dffcff; font-weight:800; }
  .pm{ color:#9fb0c9; font-weight:400; font-size:11px; }
  td input{ width:100%; min-width:78px; direction:ltr; text-align:center; color:#fff; background:rgba(3,8,20,.48); border:1px solid rgba(255,255,255,.13); border-radius:10px; padding:8px 6px; font-size:12.5px; outline:none; font-family:'Courier New',monospace; font-weight:600; }
  td input:focus{ border-color:rgba(97,231,255,.6); background:rgba(3,8,20,.65); box-shadow:0 0 0 3px rgba(97,231,255,.12); }
  td.auto-delta{ color:#8ee9ff; font-family:'Courier New',monospace; font-size:12px; font-weight:700; direction:ltr; }
  td.auto-delta span{ display:inline-block; padding:2px 7px; border-radius:6px; background:rgba(97,231,255,.08); border:1px solid rgba(97,231,255,.15); }
  .table-note{ margin-top:12px; color:#8fa2ba; font-size:12px; line-height:2; padding:0 6px; }
  .calc-grid{ display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:14px; }
  .calc-card{ padding:16px; position:relative; overflow:hidden; border-radius:20px; }
  .calc-card::before{ content:""; position:absolute; width:120px; height:120px; border-radius:50%; background:radial-gradient(circle, rgba(97,231,255,.16), transparent 70%); top:-40px; left:-30px; pointer-events:none; }
  .calc-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:12px; position:relative; z-index:1; }
  .calc-head h3{ margin:0; font-size:17px; color:#fff; }
  .values-grid{ display:flex; flex-direction:column; gap:6px; margin-bottom:14px; position:relative; z-index:1; }
  .value-row{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 12px; border-radius:10px; background:rgba(3,8,20,.28); border:1px solid rgba(255,255,255,.06); font-variant-numeric:tabular-nums; }
  .value-row.highlight{ background:linear-gradient(90deg, rgba(97,231,255,.12), rgba(167,139,250,.08)); border-color:rgba(97,231,255,.22); }
  .v-name{ color:#a5b8d1; font-size:12px; font-weight:700; direction:ltr; letter-spacing:.4px; font-family:'Courier New',monospace; }
  .v-val{ color:#eef7ff; font-size:14px; font-weight:800; direction:ltr; display:inline-flex; align-items:baseline; gap:6px; font-family:'Courier New',monospace; }
  .v-val .pm{ font-size:11.5px; color:#8ee9ff; font-weight:600; }
  .formula-line{ position:relative; z-index:1; margin:7px 0; color:#cfdaea; font-size:12.5px; line-height:1.9; }
  .formula-line.math{ direction:ltr; text-align:left; font-variant-numeric:tabular-nums; color:#e6f3ff; background:rgba(3,8,20,.26); border:1px solid rgba(255,255,255,.06); border-radius:10px; padding:7px 10px; overflow-x:auto; white-space:nowrap; font-family:'Courier New',monospace; font-size:12px; }
  .formula-line.result-line{ color:#dffcff; font-weight:800; background:linear-gradient(90deg, rgba(97,231,255,.1), rgba(167,139,250,.08)); border:1px solid rgba(97,231,255,.16); border-radius:12px; padding:9px 11px; font-family:'Courier New',monospace; direction:ltr; text-align:center; font-size:12.5px; }
  .theory-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:14px; margin-bottom:16px; }
  .theory-card{ padding:16px 16px 14px; position:relative; overflow:hidden; border-radius:20px; }
  .theory-card::before{ content:""; position:absolute; width:110px; height:110px; top:-36px; left:-30px; border-radius:50%; background:radial-gradient(circle, rgba(167,139,250,.16), transparent 70%); pointer-events:none; }
  .theory-card h3{ margin:0 0 10px; font-size:15px; color:#fff; font-weight:800; position:relative; z-index:1; }
  .theory-card p{ margin:0 0 8px; font-size:12.5px; line-height:1.95; color:#cfdaea; position:relative; z-index:1; }
  .formula-block{ position:relative; z-index:1; margin:8px 0; padding:10px 12px; background:rgba(3,8,20,.32); border:1px solid rgba(97,231,255,.14); border-radius:12px; font-family:'Courier New',monospace; direction:ltr; text-align:left; color:#dffcff; font-size:12.5px; line-height:1.9; overflow-x:auto; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .formula-block .op{ color:#61e7ff; } .formula-block .var{ color:#a78bfa; font-weight:700; } .formula-block .eq{ color:#5eead4; font-weight:800; padding:0 4px; }
  .circuit-illust{ display:grid; grid-template-columns: 1.25fr 1fr; gap:18px; align-items:center; padding:16px; border-radius:22px; margin-bottom:16px;
    background: radial-gradient(circle at 40% 20%, rgba(97,231,255,.08), transparent 45%), linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012)); border:1px solid rgba(255,255,255,.08); }
  .circuit-illust svg{ width:100%; height:auto; max-width:560px; display:block; margin:0 auto; filter: drop-shadow(0 16px 26px rgba(0,0,0,.45)); }
  .circuit-illust .cap{ display:flex; flex-direction:column; gap:8px; padding:10px; }
  .cap-row{ display:flex; align-items:flex-start; gap:9px; padding:8px 10px; border-radius:10px; background:rgba(3,8,20,.3); border:1px solid rgba(255,255,255,.06); font-size:12px; line-height:1.8; color:#cfdaea; }
  .cap-row b{ color:var(--cyan); font-family:'Courier New',monospace; font-weight:800; min-width:40px; display:inline-block; }
  .cap-row.gold b{ color:var(--gold); } .cap-row.violet b{ color:var(--violet); }
  footer{ position:relative; z-index:2; text-align:center; color:#6f8199; font-size:12px; padding:28px 10px 0; line-height:2; }

  /* جداول شبیه جزوه — چند بلوک عمودی */
  .lab-tables{ display:flex; flex-direction:column; gap:14px; width:100%; }
  .lab-tables .block-table{ width:100%; border-collapse:collapse; min-width:0 !important; }
  .lab-tables .block-table th, .lab-tables .block-table td{
    border:1px solid rgba(255,255,255,.14); padding:10px 12px; text-align:center; font-size:13px;
  }
  .lab-tables .block-table thead th{
    background:rgba(97,231,255,.12); color:#dffcff; font-weight:800; font-size:12.5px;
  }
  .lab-tables .block-table tbody td{ background:rgba(255,255,255,.03); color:#eef5ff; }
  .lab-tables .block-table input{
    width:100%; min-width:70px; direction:ltr; text-align:center; color:#fff;
    background:rgba(3,8,20,.48); border:1px solid rgba(255,255,255,.13); border-radius:8px;
    padding:7px 6px; font-size:13px; font-family:'Courier New',monospace; font-weight:600;
  }
  .lab-tables .block-table .auto{ color:#9ee8ff; font-family:'Courier New',monospace; font-weight:700; direction:ltr; }
  .lab-tables .block-table .result-cell{ color:#b8f4ff; font-weight:800; background:rgba(97,231,255,.08) !important; }
  .formula-box{
    direction:ltr; text-align:left; font-family:'Courier New',monospace;
    background:rgba(3,8,20,.4); border:1px solid rgba(97,231,255,.2); border-radius:12px;
    padding:12px 14px; margin:8px 0; color:#e6f3ff; font-size:13.5px; line-height:1.85;
    white-space:pre-wrap; overflow-x:auto;
  }
  .formula-box .title{ color:#61e7ff; font-weight:800; margin-bottom:6px; direction:rtl; text-align:right; font-family:Vazirmatn,Tahoma,sans-serif; }
  .formula-box .eq{ display:block; margin:4px 0; }
  .mini-3d-gallery{ display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; padding:8px 0 4px; }

  .ohm-graph-wrap{ background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:16px; }
  .ohm-graph-wrap svg{ width:100%; max-width:720px; height:auto; display:block; margin:0 auto; background:#fff; border-radius:8px; }
  .scale-info{ display:flex; flex-wrap:wrap; gap:10px; margin-top:10px; font-size:12.5px; color:#cfd9ea; }
  .scale-info .chip{ font-size:12px; }

  /* === Premium UI extras === */
  .shell{ position:relative; z-index:2; }
  .hero{
    position:relative; overflow:hidden;
    background:
      linear-gradient(145deg, rgba(34,211,238,.14), rgba(167,139,250,.10) 50%, rgba(244,114,182,.06));
    border:1px solid rgba(103,232,249,.25);
    box-shadow:0 28px 80px rgba(0,0,0,.4), 0 0 60px rgba(34,211,238,.08), inset 0 1px 0 rgba(255,255,255,.2);
  }
  .hero::after{
    content:''; position:absolute; width:180px; height:180px; border-radius:50%;
    background:radial-gradient(circle, rgba(34,211,238,.35), transparent 70%);
    top:-40px; left:-30px; filter:blur(20px); pointer-events:none; animation:floatOrb 12s ease-in-out infinite;
  }
  .hero h1{
    background:linear-gradient(90deg, #67e8f9, #c4b5fd 45%, #f9a8d4);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:none; filter:drop-shadow(0 2px 12px rgba(34,211,238,.25));
  }
  .section-head h2{
    letter-spacing:-.01em;
    background:linear-gradient(90deg, #e0f2fe, #c4b5fd);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .tabs{
    background:rgba(3,8,20,.45);
    border:1px solid rgba(255,255,255,.1);
    box-shadow:0 16px 50px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.08);
    backdrop-filter:blur(16px);
  }
  .tab-num{
    display:inline-flex; align-items:center; justify-content:center;
    width:26px; height:26px; border-radius:9px; font-size:12px; font-weight:800;
    background:rgba(34,211,238,.12); border:1px solid rgba(34,211,238,.25); color:#a5f3fc;
    transition:all .25s ease;
  }
  .tab-btn.active .tab-num{
    background:linear-gradient(135deg, rgba(34,211,238,.45), rgba(167,139,250,.4));
    border-color:rgba(255,255,255,.3); color:#fff;
    box-shadow:0 0 16px rgba(34,211,238,.35);
  }
  .lab-tables .block-table{
    border-radius:14px; overflow:hidden;
    box-shadow:0 12px 40px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .lab-tables .block-table thead th{
    background:linear-gradient(135deg, rgba(34,211,238,.18), rgba(167,139,250,.14)) !important;
    color:#e0f2fe !important;
    border-color:rgba(103,232,249,.2) !important;
    text-shadow:0 0 20px rgba(34,211,238,.3);
  }
  .lab-tables .block-table tbody td{
    border-color:rgba(255,255,255,.1) !important;
    transition:background .2s ease;
  }
  .lab-tables .block-table tbody tr:hover td{
    background:rgba(34,211,238,.06) !important;
  }
  .lab-tables .block-table input{
    background:rgba(2,6,18,.65) !important;
    border:1px solid rgba(103,232,249,.2) !important;
    border-radius:10px !important;
    box-shadow:inset 0 2px 8px rgba(0,0,0,.35);
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .lab-tables .block-table input:focus{
    outline:none;
    border-color:rgba(34,211,238,.55) !important;
    box-shadow:0 0 0 3px rgba(34,211,238,.15), inset 0 2px 8px rgba(0,0,0,.35);
  }
  .lab-tables .block-table .result-cell{
    background:linear-gradient(135deg, rgba(34,211,238,.12), rgba(167,139,250,.08)) !important;
    color:#a5f3fc !important;
  }
  .formula-box{
    background:linear-gradient(145deg, rgba(2,10,24,.7), rgba(15,23,42,.5)) !important;
    border:1px solid rgba(34,211,238,.22) !important;
    border-radius:16px !important;
    box-shadow:0 12px 36px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.08);
  }
  .formula-box .title{
    background:linear-gradient(90deg,#67e8f9,#c4b5fd);
    -webkit-background-clip:text; background-clip:text; color:transparent !important;
  }
  .cap-row{
    background:linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02)) !important;
    border:1px solid rgba(255,255,255,.1) !important;
    border-radius:12px !important;
    transition:transform .25s ease, border-color .25s ease;
  }
  .cap-row:hover{ transform:translateX(-3px); border-color:rgba(34,211,238,.3) !important; }
  .instruction-card{
    transform-style:preserve-3d;
    transition:transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease, border-color .3s ease;
    border:1px solid rgba(255,255,255,.12);
  }
  .instruction-card:hover{
    transform:translateY(-6px) rotateX(4deg) scale(1.02);
    box-shadow:0 24px 50px rgba(0,0,0,.4), 0 0 30px rgba(34,211,238,.12);
    border-color:rgba(103,232,249,.35);
  }
  .instruction-num{
    background:linear-gradient(135deg, #22d3ee, #a78bfa) !important;
    color:#04101a !important; font-weight:900;
    box-shadow:0 6px 18px rgba(34,211,238,.35);
  }
  .resistor-3d, .resistor-body{
    filter:drop-shadow(0 10px 20px rgba(0,0,0,.45));
  }
  .resistor-card{
    transition:transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
  }
  .resistor-card:hover{
    transform:translateY(-8px) scale(1.04);
    box-shadow:0 20px 40px rgba(0,0,0,.4), 0 0 24px rgba(167,139,250,.2);
  }
  .circuit-illust{
    perspective:1000px;
  }
  .circuit-illust svg{
    filter:drop-shadow(0 18px 30px rgba(0,0,0,.4));
    transition:transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .circuit-illust:hover svg{
    transform:translateY(-4px) scale(1.01);
  }
  .calc-card{
    transition:transform .35s ease, box-shadow .35s ease;
  }
  .calc-card:hover{
    transform:translateY(-4px);
    box-shadow:0 20px 44px rgba(0,0,0,.35), 0 0 28px rgba(167,139,250,.12);
  }
  .panel{
    animation:panelIn .55s cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes panelIn{
    from{ opacity:0; transform:translateY(16px) scale(.985); }
    to{ opacity:1; transform:translateY(0) scale(1); }
  }
  .tab-panel.active > .panel:nth-child(1){ animation-delay:.02s; }
  .tab-panel.active > .panel:nth-child(2){ animation-delay:.08s; }
  .tab-panel.active > .panel:nth-child(3){ animation-delay:.14s; }
  .tab-panel.active > .panel:nth-child(4){ animation-delay:.20s; }
  .tab-panel.active > .panel:nth-child(5){ animation-delay:.26s; }
  footer{
    background:linear-gradient(90deg, transparent, rgba(34,211,238,.08), rgba(167,139,250,.08), transparent);
    border-radius:16px; margin-top:12px; padding:18px 12px !important;
  }


  /* ===== iOS Liquid Glass Theme ===== */
  body{
    background:
      radial-gradient(ellipse 1000px 600px at 15% -10%, rgba(120,180,255,.35) 0%, transparent 50%),
      radial-gradient(ellipse 800px 500px at 90% 0%, rgba(180,140,255,.28) 0%, transparent 45%),
      radial-gradient(ellipse 700px 450px at 50% 100%, rgba(100,200,255,.15) 0%, transparent 40%),
      linear-gradient(180deg, #0b1220 0%, #121a2b 50%, #0e1524 100%) !important;
  }
  .glass, .panel.glass{
    background: rgba(255,255,255,.08) !important;
    border: 1px solid rgba(255,255,255,.22) !important;
    border-radius: 22px !important;
    box-shadow:
      0 8px 32px rgba(0,0,0,.28),
      inset 0 1px 0 rgba(255,255,255,.35),
      inset 0 -1px 0 rgba(255,255,255,.06) !important;
    backdrop-filter: blur(28px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(28px) saturate(180%) !important;
  }
  .glass::before{
    background: linear-gradient(160deg, rgba(255,255,255,.18) 0%, rgba(255,255,255,.02) 42%, transparent 70%) !important;
    opacity: 1 !important;
  }
  .glass-inset{
    background: rgba(255,255,255,.06) !important;
    border: 1px solid rgba(255,255,255,.14) !important;
    border-radius: 16px !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
  }
  .tabs{
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    border-radius: 18px !important;
    backdrop-filter: blur(24px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
    box-shadow: 0 10px 40px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.2) !important;
    padding: 6px !important;
  }
  .tab-btn{
    border-radius: 12px !important;
  }
  .tab-btn.active{
    background: rgba(255,255,255,.18) !important;
    border-color: rgba(255,255,255,.28) !important;
    box-shadow: 0 4px 16px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.3) !important;
  }
  .hero{
    background: rgba(255,255,255,.1) !important;
    border: 1px solid rgba(255,255,255,.22) !important;
    backdrop-filter: blur(30px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(30px) saturate(180%) !important;
  }
  .chip{
    background: rgba(255,255,255,.12) !important;
    border: 1px solid rgba(255,255,255,.2) !important;
    backdrop-filter: blur(10px) !important;
  }
  .btn{
    background: rgba(255,255,255,.16) !important;
    border: 1px solid rgba(255,255,255,.28) !important;
    backdrop-filter: blur(12px) !important;
    box-shadow: 0 6px 20px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.3) !important;
  }
  .lab-tables .block-table{
    border-radius: 14px !important;
    overflow: hidden !important;
    background: rgba(255,255,255,.04) !important;
  }
  .lab-tables .block-table thead th{
    background: rgba(255,255,255,.12) !important;
    border-color: rgba(255,255,255,.12) !important;
  }
  .lab-tables .block-table input{
    background: rgba(0,0,0,.25) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    border-radius: 10px !important;
  }
  .cap-row, .instruction-card, .calc-card, .formula-box{
    background: rgba(255,255,255,.06) !important;
    border: 1px solid rgba(255,255,255,.14) !important;
    backdrop-filter: blur(12px) !important;
  }

  @media print{
    @page{ size:A4 portrait; margin:7mm; }
    html, body{
      margin:0!important; padding:0!important; width:100%!important;
      background:#ffffff!important; color:#000000!important;
      overflow:visible!important; -webkit-print-color-adjust:exact!important; print-color-adjust:exact!important;
    }
    /* همه متن‌ها و اعداد سیاه و خوانا */
    .print-section, .print-circuit, .print-resistors, .print-graph,
    .print-section *, .print-circuit *, .print-resistors *, .print-graph *{
      color:#000000!important;
    }
    .print-section h2, .print-circuit h2, .print-resistors h2, .print-graph h2,
    .print-section .hint, .print-circuit .hint, .print-resistors .hint, .print-graph .hint,
    .print-header span, .cap-row, .cap-row b, .chip, .auto, .result-cell,
    .formula-box, .formula-box .title, .formula-box .eq, .table-note,
    .lab-tables td, .lab-tables th, .print-section td, .print-section th,
    input, .block-table td, .block-table th, .block-table .auto, .block-table .result-cell{
      color:#000000!important;
      background-clip:unset!important; -webkit-background-clip:unset!important;
      background-image:none!important;
    }
    .lab-tables .block-table thead th, .print-section thead th{
      background:#111111!important; color:#ffffff!important;
      border:1px solid #000000!important;
    }
    .lab-tables .block-table td, .print-section tbody td{
      background:#ffffff!important; color:#000000!important;
      border:1px solid #333333!important;
    }
    .lab-tables .block-table .result-cell, .print-section .result-cell{
      background:#f0f0f0!important; color:#000000!important; font-weight:800!important;
    }
    .lab-tables .block-table input, .print-section input{
      color:#000000!important; background:transparent!important;
      border-bottom:1px solid #000000!important;
    }
    .print-circuit svg text{ fill:#000000!important; }
    .print-circuit svg [stroke="#61e7ff"],
    .print-circuit svg [stroke="#22d3ee"],
    .print-circuit svg [stroke="#a78bfa"],
    .print-circuit svg [stroke="#f6c453"],
    .print-circuit svg [stroke="#fbbf24"]{ stroke:#000000!important; }
    .print-circuit svg [fill="#61e7ff"],
    .print-circuit svg [fill="#22d3ee"],
    .print-circuit svg [fill="#f6c453"],
    .print-circuit svg [fill="#fbbf24"],
    .print-circuit svg [fill="#c4b5fd"],
    .print-circuit svg [fill="#e9fbff"],
    .print-circuit svg [fill="#dffcff"]{ fill:#000000!important; }
    .print-circuit .cap-row{ background:#f5f5f5!important; border:1px solid #333!important; color:#000!important; }
    .print-circuit .cap-row b{ color:#000000!important; }
    .print-resistors .chip{ background:#eee!important; color:#000!important; border:1px solid #333!important; }
    .print-graph svg text{ fill:#000000!important; }
    .print-graph svg [stroke="#2563eb"],
    .print-graph svg [stroke="#1e40af"],
    .print-graph svg [stroke="#f59e0b"]{ stroke:#000000!important; }
    .print-graph svg [fill="#2563eb"],
    .print-graph svg [fill="#f59e0b"]{ fill:#000000!important; }

    *, *::before, *::after{
      -webkit-print-color-adjust:exact!important; print-color-adjust:exact!important;
      text-shadow:none!important; box-shadow:none!important;
      animation:none!important; transition:none!important;
      filter:none!important; backdrop-filter:none!important; -webkit-backdrop-filter:none!important;
      transform:none!important;
    }
    .bg-grid, .orb, .hero, .tabs, footer, .btn, .btn-row, button.btn, button.btn-mini,
    .instructions-grid, .instruction-card, .calc-grid, .calc-card,
    .circuit-controls, .circuit-hint, .legend, .readout, .no-print,
    .tilt-3d, .hero::after, .glass::before{ display:none!important; }

    .shell{ display:block!important; width:100%!important; max-width:none!important; margin:0!important; padding:0!important; background:#fff!important; }
    .glass, .glass-inset, .panel, .panel.glass{
      background:#fff!important; border:1px solid #94a3b8!important; border-radius:3px!important;
      box-shadow:none!important; padding:2.5mm 3mm!important; margin:0 0 3mm 0!important;
    }

    .tab-panel{ display:none!important; }
    .tab-panel.active{ display:block!important; }

    /* فقط شکل + مقاومت + جدول + نمودار */
    .tab-panel.active > section:not(.print-section):not(.print-circuit):not(.print-resistors):not(.print-graph){
      display:none!important;
    }
    .print-section, .print-circuit, .print-resistors, .print-graph{
      display:block!important; position:static!important; width:100%!important;
      margin:0 0 2mm 0!important; padding:1.5mm 2.5mm!important;
      background:#fff!important; border:1px solid #334155!important; border-radius:2px!important;
      page-break-inside:avoid!important; overflow:visible!important;
    }

    .section-head, .print-section .section-head, .print-circuit .section-head,
    .print-resistors .section-head, .print-graph .section-head{
      display:block!important; text-align:center!important;
      margin:0 0 2mm 0!important; padding:0 0 1.5mm 0!important;
      border-bottom:1.4px solid #0f172a!important; background:transparent!important;
    }
    .section-head h2, .print-section .section-head h2, .print-circuit .section-head h2,
    .print-resistors .section-head h2, .print-graph .section-head h2{
      color:#000000!important; font-size:11pt!important; margin:0!important; font-weight:800!important;
      background:none!important; -webkit-background-clip:unset!important; background-clip:unset!important;
      filter:none!important;
    }
    .section-head .hint, .print-section .section-head .hint, .print-circuit .section-head .hint,
    .print-resistors .section-head .hint, .print-graph .section-head .hint{
      color:#000000!important; font-size:7.5pt!important; margin:.5mm 0 0!important; line-height:1.4!important;
    }
    .section-head .chips, .print-section .section-head .chips, .print-circuit .section-head .chips{ display:none!important; }

    .print-header.print-only{ display:block!important; }
    .print-header .ph-fields{
      display:flex!important; flex-wrap:wrap!important; justify-content:space-between!important;
      gap:2mm 5mm!important; color:#000000!important; font-size:9pt!important;
      padding:0 0 2mm 0!important; margin:0 0 2.5mm 0!important;
      border-bottom:1px dashed #64748b!important;
    }
    .print-header .ph-fields span{ color:#000000!important; white-space:nowrap!important; }

    /* مدار */
    .print-circuit .circuit-illust, .print-circuit .simple-circuit-wrap, .print-circuit .circuit-stage{
      display:block!important; margin:0 auto!important; max-width:100%!important;
      background:#fff!important; border:none!important; perspective:none!important;
    }
    .print-circuit .circuit-illust{
      display:grid!important; grid-template-columns:1.45fr .9fr!important; gap:2mm!important;
    }
    .print-circuit svg, .print-circuit .simple-circuit-svg{
      max-height:42mm!important; width:100%!important; margin:0 auto!important; display:block!important;
      background:#fff!important; filter:none!important;
    }
    .print-circuit .cap{ font-size:7.5pt!important; color:#000000!important; }
    .print-circuit .cap-row{
      background:#f8fafc!important; border:1px solid #cbd5e1!important; color:#000000!important;
      padding:1mm 1.5mm!important; margin:0 0 1mm!important; border-radius:2px!important;
    }
    .print-circuit .cap-row b{ color:#1e40af!important; }
    .print-circuit svg text{ fill:#000000!important; }
    .print-circuit svg [stroke="#61e7ff"],
    .print-circuit svg [stroke="#22d3ee"],
    .print-circuit svg [stroke="#a78bfa"]{ stroke:#1e40af!important; }
    .print-circuit svg [stroke="#f6c453"],
    .print-circuit svg [stroke="#fbbf24"]{ stroke:#b45309!important; }
    .print-circuit svg [fill="#0a1224"],
    .print-circuit svg [fill="#050b18"],
    .print-circuit svg [fill="#070b16"]{ fill:#ffffff!important; }
    .print-circuit svg [fill="#61e7ff"],
    .print-circuit svg [fill="#22d3ee"]{ fill:#1e40af!important; }
    .print-circuit svg [fill="#f6c453"],
    .print-circuit svg [fill="#fbbf24"]{ fill:#b45309!important; }
    .print-circuit svg [fill="#c4b5fd"],
    .print-circuit svg [fill="#e9fbff"],
    .print-circuit svg [fill="#dffcff"]{ fill:#000000!important; }

    /* مقاومت‌ها */
    .print-resistors .color-controls{
      display:grid!important; grid-template-columns:repeat(auto-fit,minmax(130px,1fr))!important; gap:2mm!important;
    }
    .print-resistors .color-row, .print-resistors .glass-inset{
      background:#f8fafc!important; border:1px solid #cbd5e1!important; padding:2mm!important;
      border-radius:3px!important; color:#000000!important;
    }
    .print-resistors .color-row > div:first-child,
    .print-resistors .color-row div{ color:#000000!important; }
    .print-resistors select, .print-resistors label{ display:none!important; }
    .print-resistors .mini-bands{ display:flex!important; gap:2px!important; margin-top:1.5mm!important; }
    .print-resistors .band-dot{
      width:8px!important; height:14px!important; border:1px solid #000!important; border-radius:2px!important;
    }
    .print-resistors .mini-3d-gallery, .mini-3d-gallery{
      display:grid!important; grid-template-columns:repeat(auto-fit,minmax(90px,1fr))!important;
      gap:2mm!important; margin-top:2mm!important;
    }
    .print-resistors .resistor-card, .mini-3d-gallery .resistor-card{
      background:#fff!important; border:1px solid #cbd5e1!important; padding:2mm!important; color:#000000!important;
    }
    .print-resistors .resistor-3d, .print-resistors .resistor-body{ filter:none!important; }
    .print-resistors .chips{ display:flex!important; flex-wrap:wrap!important; gap:1.5mm!important; margin-bottom:2mm!important; }
    .print-resistors .chip{
      background:#e2e8f0!important; color:#000000!important; border:1px solid #94a3b8!important;
      font-size:7.5pt!important; padding:1mm 2mm!important; box-shadow:none!important;
    }

    /* جداول */
    .lab-tables{ gap:2.5mm!important; }
    .lab-tables .block-table, .print-section table{
      width:100%!important; min-width:0!important; table-layout:fixed!important;
      border-collapse:collapse!important; margin:0 0 2mm 0!important;
      border-radius:0!important; overflow:visible!important; box-shadow:none!important;
    }
    .lab-tables .block-table th, .print-section thead th{
      background:#1e293b!important; color:#ffffff!important; border:1px solid #0f172a!important;
      font-size:7pt!important; padding:1mm 0.8mm!important; font-weight:700!important;
      text-shadow:none!important;
    }
    .lab-tables .block-table td, .print-section tbody td{
      background:#ffffff!important; color:#000000!important; border:1px solid #94a3b8!important;
      font-size:7.5pt!important; padding:1mm 0.8mm!important;
    }
    .lab-tables .block-table tr:nth-child(even) td,
    .print-section tbody tr:nth-child(even) td{ background:#f1f5f9!important; }
    .lab-tables .block-table .result-cell, .print-section .result-cell{
      background:#e0f2fe!important; color:#000000!important; font-weight:800!important;
    }
    .lab-tables .block-table input, .print-section td input{
      color:#000000!important; border:none!important; border-bottom:1px solid #64748b!important;
      background:transparent!important; font-size:8pt!important; padding:0!important;
      box-shadow:none!important; border-radius:0!important;
    }
    .lab-tables .block-table .auto, .print-section .auto{ color:#000000!important; font-size:7.5pt!important; }
    .print-section .mini-bands{ display:flex!important; justify-content:center!important; gap:1.5px!important; }
    .print-section .band-dot{ width:6px!important; height:11px!important; border:1px solid #000!important; }
    .print-section h3{ color:#000000!important; font-size:10pt!important; margin:2mm 0 1.5mm!important; }

    /* نمودارها */
    .print-graph .ohm-graph-wrap, .print-graph #ohmGraphSvg, .print-graph #exp8GraphSvg, .print-graph #exp9GraphSvg{
      background:#fff!important; border:1px solid #94a3b8!important; padding:2mm!important;
    }
    .print-graph svg, .print-graph canvas{
      max-height:70mm!important; width:100%!important; display:block!important; margin:0 auto!important;
      background:#fff!important; filter:none!important;
    }
    .print-graph .scale-info, .print-graph .formula-box, .print-graph .chip{
      color:#000000!important; font-size:8pt!important;
    }
    .print-graph .chip{
      background:#e2e8f0!important; border:1px solid #94a3b8!important; color:#000000!important;
      box-shadow:none!important;
    }
    .print-graph .formula-box, .formula-box{
      background:#f8fafc!important; border:1px solid #cbd5e1!important; color:#000000!important;
      font-size:8pt!important; box-shadow:none!important;
    }
    .print-graph .formula-box .title, .formula-box .title{
      color:#000000!important; background:none!important;
      -webkit-background-clip:unset!important; background-clip:unset!important;
    }
    .print-graph .formula-box .eq{ color:#000000!important; }

    .table-note{ color:#111111!important; font-size:7pt!important; }

    /* فشرده‌سازی برای حداکثر ۲ صفحه */
    .print-resistors .mini-3d-gallery{ max-height:28mm!important; overflow:hidden!important; }
    .print-resistors .resistor-card .card-info{ font-size:7pt!important; }
    .print-circuit .cap-row{ margin:0 0 0.6mm!important; padding:0.6mm 1mm!important; font-size:7pt!important; }
    .print-graph .formula-box{ padding:1.5mm!important; margin-top:1.5mm!important; }
    .print-section .btn-row, .print-section button{ display:none!important; }
  }
  @media (max-width: 980px){
    .color-row{ grid-template-columns:64px 1fr 1fr; } .color-row .fixed-tol{ grid-column:1 / -1; text-align:right; direction:rtl; }
    .calc-grid{ grid-template-columns:1fr; } .circuit-stage{ height:400px; } .resistor-gallery{ grid-template-columns:repeat(2, 1fr); }
    .simple-circuit-wrap{ grid-template-columns:1fr; } .circuit-illust{ grid-template-columns:1fr; }
    .tab-btn{ font-size:11.5px; padding:11px 8px; min-width:130px; }
  }
  @media (max-width: 620px){
    .shell{ width:min(100% - 16px, 1480px); padding-top:12px; }
    .hero, .panel{ padding:16px; border-radius:20px; }
    .tabs{ padding:5px; } .tab-btn{ min-width:110px; font-size:10.5px; padding:10px 5px; gap:5px; }
    .tab-num{ width:22px; height:22px; font-size:11px; }
    .color-row{ grid-template-columns:1fr; } .resistor-gallery{ grid-template-columns:repeat(2, 1fr); gap:10px; }
    .resistor-card{ padding:18px 10px 12px; } .circuit-stage{ height:320px; }
  }

/* ===== 3INA3 copyright & watermark ===== */
.wm-layer{
  position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;
  display:flex; flex-wrap:wrap; align-content:space-around; justify-content:space-around;
}
.wm-layer span{
  font-size:clamp(1.15rem,2.6vw,2rem); font-weight:900; letter-spacing:.07em;
  color:rgba(34,211,238,.05);
  transform:rotate(-16deg);
  padding:1.3rem 1.6rem; user-select:none; white-space:nowrap;
}
.shell, header, .hero, .panel, .tabs, footer { position:relative; z-index:2; }
.copy-banner{
  position:relative; z-index:3;
  max-width:1480px; margin:0 auto 14px; width:calc(100% - 28px);
  padding:16px 18px; border-radius:18px; text-align:center;
  background:linear-gradient(145deg, rgba(34,211,238,.12), rgba(167,139,250,.10));
  border:1px solid rgba(255,255,255,.14);
  box-shadow:0 12px 36px rgba(0,0,0,.35);
}
.copy-banner h2{
  margin:0 0 8px; font-size:1.05rem; font-weight:800;
  background:linear-gradient(90deg,#67e8f9,#a78bfa,#fbbf24);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.copy-banner p{ margin:0; font-size:.74rem; line-height:1.85; color:#b6c5dd; }
.copy-banner a{ color:#67e8f9; font-weight:700; }
.footer-copy{
  position:relative; z-index:3;
  max-width:1480px; margin:28px auto 20px; width:calc(100% - 28px);
  padding:14px 16px; text-align:center; font-size:.72rem; color:#93a4c3; line-height:1.8;
  border-radius:16px; border:1px solid rgba(255,255,255,.12);
  background:linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
}
.footer-copy strong{ color:#e8f4ff; }
.footer-copy a{ color:#67e8f9; font-weight:700; }
.print-running{ display:none; }
@media print{
  .wm-layer{
    position:fixed !important; inset:0 !important; z-index:0 !important;
    -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;
  }
  .wm-layer span{
    color:rgba(30,64,175,.08) !important;
    -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;
  }
  .print-running{
    display:block !important; position:fixed; left:0; right:0; font-size:8pt; color:#64748b;
    -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;
  }
  .print-running.top{ top:4mm; text-align:center; border-bottom:.4pt solid #cbd5e1; padding-bottom:1.5mm; }
  .print-running.bottom{ bottom:4mm; text-align:center; border-top:.4pt solid #cbd5e1; padding-top:1.5mm; }
  body{ padding-top:10mm; padding-bottom:12mm; }
  .copy-banner, .orb, .bg-grid, .no-print { display:none !important; }
  .shell, .panel, .hero { position:relative; z-index:1; }
}



/* ===== PRINT: force watermark + copyright on every page ===== */
@media print{
  @page{
    size: A4;
    margin: 14mm 12mm 16mm 12mm;
  }
  html, body{
    background: #fff !important;
    color: #0f172a !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .orb, .bg-grid, .no-print, .tabs, .hero-actions, .btn, .btn-row {
    display: none !important;
  }
  /* fixed watermark on every printed page */
  .wm-layer{
    position: fixed !important;
    inset: 0 !important;
    z-index: 0 !important;
    display: flex !important;
    flex-wrap: wrap !important;
    align-content: space-around !important;
    justify-content: space-around !important;
    opacity: 1 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .wm-layer span{
    color: rgba(30, 64, 175, 0.09) !important;
    font-size: 14pt !important;
    font-weight: 800 !important;
    transform: rotate(-18deg) !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  /* running header/footer every page */
  .print-running{
    display: block !important;
    position: fixed !important;
    left: 0 !important;
    right: 0 !important;
    font-size: 8pt !important;
    color: #334155 !important;
    z-index: 9999 !important;
    background: #fff !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .print-running.top{
    top: 3mm !important;
    text-align: center !important;
    border-bottom: 0.5pt solid #94a3b8 !important;
    padding: 0 4mm 1.5mm !important;
  }
  .print-running.bottom{
    bottom: 3mm !important;
    text-align: center !important;
    border-top: 0.5pt solid #94a3b8 !important;
    padding: 1.5mm 4mm 0 !important;
  }
  body{
    padding-top: 11mm !important;
    padding-bottom: 12mm !important;
  }
  .shell, .panel, .hero, .tab-panel, .glass, .glass-inset, section {
    position: relative !important;
    z-index: 1 !important;
    background: #fff !important;
    color: #0f172a !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
  .copy-banner{
    display: block !important;
    background: #f8fafc !important;
    border: 1pt solid #64748b !important;
    color: #0f172a !important;
    page-break-after: avoid;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .copy-banner h2{
    background: none !important;
    -webkit-background-clip: initial !important;
    background-clip: initial !important;
    color: #0f172a !important;
  }
  .copy-banner p, .copy-banner a{
    color: #1e293b !important;
  }
  .footer-copy{
    display: block !important;
    background: #f8fafc !important;
    border: 1pt solid #64748b !important;
    color: #0f172a !important;
    page-break-before: avoid;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  .footer-copy strong, .footer-copy a{
    color: #0f172a !important;
  }
  /* keep tables readable */
  table, th, td, input, .result-cell, .auto {
    color: #0f172a !important;
    border-color: #94a3b8 !important;
  }
  thead th{
    background: #e2e8f0 !important;
    color: #0f172a !important;
  }
  *{
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}


.print-only-stamp{display:none}
@media print{
  .print-only-stamp{
    display:block !important;
    position:fixed !important;
    top:50% !important; left:50% !important;
