  <!-- ============ EXP 10: Oscilloscope ============ -->
  <div class="tab-panel" id="exp10">
    <section class="panel glass print-circuit">
      <div class="section-head"><div><h2>آزمایش ۱۰ — اندازه‌گیری با نوسان‌نما (مطابق جزوه)</h2><div class="hint">اسیلوسکوپ · سیگنال ژنراتور · ولت‌متر AC/DC</div></div><div class="chips"><span class="chip">Vpp</span><span class="chip">Vs = Vpp/2</span><span class="chip">Vrms = Vpp/(2√2)</span><span class="chip">f = 1/T</span></div></div>
      <div class="circuit-illust glass-inset" style="grid-template-columns:1.4fr 1fr">
        <svg viewBox="0 0 640 300" xmlns="http://www.w3.org/2000/svg">
          <!-- scope screen -->
          <rect x="40" y="40" width="320" height="220" rx="8" fill="#0a1224" stroke="#61e7ff" stroke-width="2.5"/>
          <!-- grid -->
          <g stroke="#1e3a5f" stroke-width="0.8">
            <path d="M40 95 H360 M40 150 H360 M40 205 H360 M120 40 V260 M200 40 V260 M280 40 V260"/>
          </g>
          <!-- sine wave -->
          <path d="M60 150 C90 80, 110 80, 140 150 S190 220, 220 150 S270 80, 300 150 S340 220, 350 180" fill="none" stroke="#61e7ff" stroke-width="2.5"/>
          <!-- Vpp arrow -->
          <line x1="140" y1="85" x2="140" y2="215" stroke="#f6c453" stroke-width="1.8" stroke-dasharray="4 2"/>
          <text x="152" y="155" fill="#f6c453" font-size="13" font-weight="800" font-family="Courier New">Vpp</text>
          <!-- T arrow -->
          <line x1="140" y1="240" x2="300" y2="240" stroke="#a78bfa" stroke-width="1.8"/>
          <text x="210" y="255" fill="#c4b5fd" font-size="13" font-weight="800" text-anchor="middle" font-family="Courier New">T</text>
          <!-- labels -->
          <text x="200" y="30" fill="#e9fbff" font-size="13" font-weight="800" text-anchor="middle">صفحه نوسان‌نما</text>
          <!-- generator box -->
          <rect x="400" y="80" width="200" height="120" rx="10" fill="#0a1224" stroke="#a78bfa" stroke-width="2"/>
          <text x="500" y="120" fill="#c4b5fd" font-size="14" font-weight="800" text-anchor="middle">سیگنال ژنراتور</text>
          <text x="500" y="150" fill="#9fb0c9" font-size="12" text-anchor="middle">f , شکل موج</text>
          <text x="500" y="175" fill="#9fb0c9" font-size="12" text-anchor="middle">→ CH1 / CH2</text>
        </svg>
        <div class="cap">
          <div class="cap-row"><b>Vpp</b> قله تا قله</div>
          <div class="cap-row"><b>Vs</b> = Vpp / 2 دامنه</div>
          <div class="cap-row"><b>Vrms</b> = Vpp / (2√2)</div>
          <div class="cap-row"><b>T</b> دوره تناوب · f = 1/T</div>
          <div class="cap-row violet"><b>Vpp</b> = (خانه‌های عمودی) × Volt/Div</div>
          <div class="cap-row violet"><b>T</b> = (خانه‌های افقی) × Time/Div</div>
        </div>
      </div>
    </section>

    <section class="panel glass print-resistors">
      <div class="section-head"><div><h2>وسایل — آزمایش ۱۰</h2></div></div>
      <div class="chips"><span class="chip">نوسان‌نما (اسیلوسکوپ)</span><span class="chip">سیگنال ژنراتور</span><span class="chip">ولت‌متر</span><span class="chip">منبع تغذیه</span></div>
    </section>

    <section class="panel glass">
      <div class="section-head"><div><h2>توضیحات و فرمول‌ها — آزمایش ۱۰</h2></div></div>
      <div class="instructions-grid">
        <article class="instruction-card glass-inset tilt-3d"><div class="instruction-num">۱</div><h3>ولتاژهای موج</h3><p><code>Vs = Vpp / 2</code></p><p><code>Vrms = Veff = Vs / √2 = Vpp / (2√2)</code></p></article>
        <article class="instruction-card glass-inset tilt-3d"><div class="instruction-num">۲</div><h3>دوره و فرکانس</h3><p><code>f = 1 / T</code></p><p>T فاصله دو قله (یا دو دره) متوالی روی محور زمان است.</p></article>
        <article class="instruction-card glass-inset tilt-3d"><div class="instruction-num">۳</div><h3>خواندن از صفحه</h3><p><code>Vpp = (تعداد خانه عمودی) × (Volt/Div)</code></p><p><code>T = (تعداد خانه افقی) × (Time/Div)</code></p></article>
        <article class="instruction-card glass-inset tilt-3d"><div class="instruction-num">۴</div><h3>درصد انحراف</h3><p>DC: <code>|V_osc − V_meter| / V_meter × 100</code></p><p>فرکانس: <code>|f_FG − f_E| / f_FG × 100</code></p><p>AC: <code>|Vrms − V_AC| / V_AC × 100</code></p></article>
      </div>
    </section>

    <section class="panel glass print-section" id="exp10-table">
      <div class="section-head"><div><h2>جدول‌ها — آزمایش ۱۰ (مطابق جزوه)</h2></div></div>
      <div class="print-header print-only"><div class="ph-fields"><span>نام و نام خانوادگی: ................................</span><span>شماره سکشن: ........</span><span>شماره دانشجویی: ................................</span><span>تاریخ: ................................</span></div></div>

      <h3 style="margin:8px 0 6px;font-size:14px;color:#dffcff">۱) اندازه‌گیری ولتاژ DC</h3>
      <div class="btn-row no-print" style="margin-bottom:8px;display:flex;gap:8px">
        <button type="button" class="btn mini" id="exp10AddDc">+ ردیف DC</button>
        <button type="button" class="btn mini" id="exp10DelDc">حذف آخرین</button>
      </div>
      <div class="lab-tables" id="exp10DcBody"></div>

      <h3 style="margin:14px 0 6px;font-size:14px;color:#dffcff">۲) اندازه‌گیری ولتاژ AC و فرکانس</h3>
      <div class="lab-tables" id="exp10AcBody"></div>
    </section>

    <section class="panel glass"><div class="section-head"><div><h2>فرمول‌ها و نتیجه — آزمایش ۱۰</h2></div></div><div class="calc-grid" id="exp10Cards"></div></section>
  </div>

  <footer>ساخته‌شده برای آزمایشگاه فیزیک پایه ۲ — مقاومت، قانون اهم، سری، موازی، مدارهای مختلف، پل وتسون، تحقیق قانون اهم، قوانین کیرشهف، شارژ خازن، دشارژ خازن، نوسان‌نما</footer>
</div>

<script>
  const COLORS = {
    black:{name:'سیاه',digit:0,mult:1,hex:'#111111'}, brown:{name:'قهوه‌ای',digit:1,mult:10,hex:'#6b3e26'},
    red:{name:'قرمز',digit:2,mult:100,hex:'#e63946'}, orange:{name:'نارنجی',digit:3,mult:1000,hex:'#f77f00'},
    yellow:{name:'زرد',digit:4,mult:10000,hex:'#ffd60a'}, green:{name:'سبز',digit:5,mult:100000,hex:'#2a9d8f'},
    blue:{name:'آبی',digit:6,mult:1000000,hex:'#277da1'}, violet:{name:'بنفش',digit:7,mult:10000000,hex:'#7b2cbf'},
    gray:{name:'خاکستری',digit:8,mult:100000000,hex:'#8d99ae'}, white:{name:'سفید',digit:9,mult:1000000000,hex:'#f8f9fa'},
    gold:{name:'طلایی',mult:0.1,hex:'#d4af37'}, silver:{name:'نقره‌ای',mult:0.01,hex:'#c0c0c0'}
  };
  const digitColors=['black','brown','red','orange','yellow','green','blue','violet','gray','white'];
  const multColors=['black','brown','red','orange','yellow','green','blue','violet','gray','white','gold','silver'];

  // همه پیش‌فرض‌ها صفر
  const initialRows=[
    {b1:'black',b2:'black',b3:'black',rdStr:'0',veStr:'0',ieStr:'0'},
    {b1:'black',b2:'black',b3:'black',rdStr:'0',veStr:'0',ieStr:'0'},
    {b1:'black',b2:'black',b3:'black',rdStr:'0',veStr:'0',ieStr:'0'},
    {b1:'black',b2:'black',b3:'black',rdStr:'0',veStr:'0',ieStr:'0'},
    {b1:'black',b2:'black',b3:'black',rdStr:'0',veStr:'0',ieStr:'0'}
  ];
  const initialSeries=[{r1Str:'0',r2Str:'0',v1Str:'0',v2Str:'0',veStr:'0',ieStr:'0',
    r1b1:'brown',r1b2:'green',r1b3:'brown', r2b1:'red',r2b2:'red',r2b3:'red'}];
  const initialParallel=[{r1Str:'0',r2Str:'0',i1Str:'0',i2Str:'0',veStr:'0',ieStr:'0',
    r1b1:'brown',r1b2:'green',r1b3:'brown', r2b1:'red',r2b2:'red',r2b3:'red'}];
  const initialExp4=[{r1Str:'0',r2Str:'0',r3Str:'0',v1Str:'0',v2Str:'0',v3Str:'0',veStr:'0',i1Str:'0',i2Str:'0',i3Str:'0',ieStr:'0',
    r1b1:'red',r1b2:'brown',r1b3:'red', r2b1:'green',r2b2:'blue',r2b3:'red', r3b1:'yellow',r3b2:'violet',r3b3:'brown'}];

  let rows=initialRows.map(r=>({...r}));
  let seriesRows=initialSeries.map(r=>({...r}));
  let parallelRows=initialParallel.map(r=>({...r}));
  let exp4Rows=initialExp4.map(r=>({...r}));
  const initialExp5=[{r1Str:'0',r2Str:'0',rxthStr:'0',rpStr:'0',
    r1b1:'brown',r1b2:'black',r1b3:'red', r2b1:'orange',r2b2:'orange',r2b3:'red', r3b1:'blue',r3b2:'gray',r3b3:'red'}];
  let exp5Rows=initialExp5.map(r=>({...r}));

  const initialExp6Pts=[
    {vStr:'',iStr:''},{vStr:'',iStr:''},{vStr:'',iStr:''},{vStr:'',iStr:''},{vStr:'',iStr:''}
  ];
  let exp6Pts=initialExp6Pts.map(r=>({...r}));
  let exp6Meta={rdStr:'0', b1:'blue', b2:'gray', b3:'red'};

  const initialExp7={
    r1Str:'', r2Str:'', r3Str:'', v1Str:'', v2Str:'',
    i1eStr:'', i2eStr:'', i3eStr:'',
    r1b1:'blue', r1b2:'gray', r1b3:'red',
    r2b1:'green', r2b2:'blue', r2b3:'brown',
    r3b1:'red', r3b2:'red', r3b3:'red'
  };
  let exp7 = {...initialExp7};
  let exp8Pts = Array.from({length:8},()=>({tStr:'',vStr:''}));
  let exp8Meta = {vmStr:'', rStr:'100', cthStr:'220'};
  let exp9Pts = Array.from({length:8},()=>({tStr:'',vStr:''}));
  let exp9Meta = {vmStr:'', rStr:'100', cthStr:'220'};
  let exp10Dc = [{oscStr:'', metStr:''},{oscStr:'', metStr:''},{oscStr:'', metStr:''}];
  let exp10Ac = {wave:'سینوسی', tStr:'', ffgStr:'', nVStr:'', voltDivStr:'', nTStr:'', timeDivStr:'', vacStr:''};






  let active=0;

  function autoDelta(str){
    const s=String(str??'').trim();
    if(!s||!/^[-+]?\d+(\.\d+)?$/.test(s))return 1;
    const d=s.indexOf('.');
    if(d===-1)return 1;
    return Math.pow(10,-(s.length-d-1));
  }
  function parseNum(str){
    const s=String(str??'').trim().replace(/,/g,'');
    const n=parseFloat(s); return isFinite(n)?n:0;
  }
  function fmt(n,digits){
    if(!isFinite(n))return '—';
    if(n===0)return '0';
    const abs=Math.abs(n);
    let d=digits;
    if(d===undefined){
      if(abs<0.0001)d=7; else if(abs<0.001)d=6; else if(abs<0.01)d=5;
      else if(abs<1)d=4; else if(abs<1000)d=3; else d=1;
    }
    return n.toLocaleString('fa-IR',{maximumFractionDigits:d,minimumFractionDigits:0,useGrouping:true});
  }
  function fmtAutoDelta(n){
    if(!isFinite(n))return '—';
    if(n>=1)return String(n);
    return n.toFixed(Math.min(8,Math.ceil(-Math.log10(n))));
  }
  function bandSpan(color){
    return `<span class="band-dot" style="background:${COLORS[color].hex};color:${COLORS[color].hex}"></span>`;
  }
  function optionList(colors,selected){
    return colors.map(c=>`<option value="${c}" ${c===selected?'selected':''}>${COLORS[c].name}</option>`).join('');
  }

  /* ====== Calc Functions ====== */
  function calcRow(r){
    const d1=COLORS[r.b1].digit,d2=COLORS[r.b2].digit,m=COLORS[r.b3].mult;
    const rc=(d1*10+d2)*m,drc=rc*0.05;
    const rd=parseNum(r.rdStr),drd=autoDelta(r.rdStr);
    const ve=parseNum(r.veStr),dve=autoDelta(r.veStr);
    const ie=parseNum(r.ieStr),die=autoDelta(r.ieStr);
    const re=ie!==0?ve/ie:NaN;
    const dre=(ie!==0&&ve!==0)?Math.abs(re)*(Math.abs(dve/ve)+Math.abs(die/ie)):NaN;
    return {d1,d2,m,rc,drc,rd,drd,ve,dve,ie,die,re,dre};
  }
  function calcSeriesRow(r){
    const r1=parseNum(r.r1Str),dr1=autoDelta(r.r1Str);
    const r2=parseNum(r.r2Str),dr2=autoDelta(r.r2Str);
    const v1=parseNum(r.v1Str),dv1=autoDelta(r.v1Str);
    const v2=parseNum(r.v2Str),dv2=autoDelta(r.v2Str);
    const ve=parseNum(r.veStr),dve=autoDelta(r.veStr);
    const ie=parseNum(r.ieStr),die=autoDelta(r.ieStr);
    const rs=r1+r2,drs=dr1+dr2;
    const vs=v1+v2,dvs=dv1+dv2;
    const re=ie!==0?ve/ie:NaN;
    const dre=(ie!==0&&ve!==0)?Math.abs(re)*(Math.abs(dve/ve)+Math.abs(die/ie)):NaN;
    return {r1,dr1,r2,dr2,rs,drs,v1,dv1,v2,dv2,vs,dvs,ve,dve,ie,die,re,dre};
  }
  function calcParallelRow(r){
    const r1=parseNum(r.r1Str),dr1=autoDelta(r.r1Str);
    const r2=parseNum(r.r2Str),dr2=autoDelta(r.r2Str);
    const i1=parseNum(r.i1Str),di1=autoDelta(r.i1Str);
    const i2=parseNum(r.i2Str),di2=autoDelta(r.i2Str);
    const ve=parseNum(r.veStr),dve=autoDelta(r.veStr);
    const ie=parseNum(r.ieStr),die=autoDelta(r.ieStr);
    const rp=(r1+r2)!==0?(r1*r2)/(r1+r2):NaN;
    const drp=(r1>0&&r2>0)?Math.pow(rp,2)*(dr1/Math.pow(r1,2)+dr2/Math.pow(r2,2)):NaN;
    const ip=i1+i2,dip=di1+di2;
    const re=ie!==0?ve/ie:NaN;
    const dre=(ie!==0&&ve!==0)?Math.abs(re)*(Math.abs(dve/ve)+Math.abs(die/ie)):NaN;
    return {r1,dr1,r2,dr2,rp,drp,i1,di1,i2,di2,ip,dip,ve,dve,ie,die,re,dre};
  }
  function calcExp4Row(r){
    const r1=parseNum(r.r1Str),dr1=autoDelta(r.r1Str);
    const r2=parseNum(r.r2Str),dr2=autoDelta(r.r2Str);
    const r3=parseNum(r.r3Str),dr3=autoDelta(r.r3Str);
    const v1=parseNum(r.v1Str),dv1=autoDelta(r.v1Str);
    const v2=parseNum(r.v2Str),dv2=autoDelta(r.v2Str);
    const v3=parseNum(r.v3Str),dv3=autoDelta(r.v3Str);
    const ve=parseNum(r.veStr),dve=autoDelta(r.veStr);
    const i1=parseNum(r.i1Str),di1=autoDelta(r.i1Str);
    const i2=parseNum(r.i2Str),di2=autoDelta(r.i2Str);
    const i3=parseNum(r.i3Str),di3=autoDelta(r.i3Str);
    const ie=parseNum(r.ieStr),die=autoDelta(r.ieStr);
    // مقاومت معادل موازی
    const rp=(r1+r2)!==0?(r1*r2)/(r1+r2):NaN;
    const drp=(r1>0&&r2>0)?Math.pow(rp,2)*(dr1/Math.pow(r1,2)+dr2/Math.pow(r2,2)):NaN;
    // مقاومت کل تئوری
    const rc=(isFinite(rp)?rp:0)+r3;
    const drc=(isFinite(drp)?drp:0)+dr3;
    // مقاومت تجربی
    const re=ie!==0?ve/ie:NaN;
    const dre=(ie!==0&&ve!==0)?Math.abs(re)*(Math.abs(dve/ve)+Math.abs(die/ie)):NaN;
    // درصد خطاها
    const errRC=(isFinite(rc)&&rc!==0&&isFinite(re))?Math.abs(rc-re)/Math.abs(rc)*100:NaN;
    const errI3=(i3!==0&&isFinite(ie))?Math.abs(i3-ie)/Math.abs(i3)*100:NaN;
    return {r1,dr1,r2,dr2,r3,dr3,rp,drp,rc,drc,v1,dv1,v2,dv2,v3,dv3,ve,dve,i1,di1,i2,di2,i3,di3,ie,die,re,dre,errRC,errI3};
  }

  /* ====== Render Gallery ====== */
  function calcExp5Row(r){
    const r1=parseNum(r.r1Str), r2=parseNum(r.r2Str), rxth=parseNum(r.rxthStr), rp=parseNum(r.rpStr);
    const dr1=autoDelta(r.r1Str), dr2=autoDelta(r.r2Str), drxth=autoDelta(r.rxthStr), drp=autoDelta(r.rpStr);
    const rxexp = (r2!==0) ? (r1/r2)*rp : NaN;
    const drxexp = (isFinite(rxexp) && r1 && r2 && rp) ? rxexp*(dr1/Math.abs(r1)+dr2/Math.abs(r2)+drp/Math.abs(rp)) : NaN;
    const err = (isFinite(rxexp) && rxth) ? Math.abs(rxth-rxexp)/Math.abs(rxth)*100 : NaN;
    return {r1,r2,rxth,rp,dr1,dr2,drxth,drp,rxexp,drxexp,err};
  }

  function renderGallery(){
    const g=document.getElementById('resistorGallery');
    if(!g) return;
    g.innerHTML=rows.map((r,i)=>{
      const c=calcRow(r);
      return `<div class="resistor-card ${i===active?'active':''}" data-index="${i}" tabindex="0" role="button">
        <div class="resistor-3d">
          <div class="lead left"></div>
          <div class="resistor-body">
            <span class="band" data-band="1" style="background:${COLORS[r.b1].hex};color:${COLORS[r.b1].hex}"></span>
            <span class="band" data-band="2" style="background:${COLORS[r.b2].hex};color:${COLORS[r.b2].hex}"></span>
            <span class="band" data-band="3" style="background:${COLORS[r.b3].hex};color:${COLORS[r.b3].hex}"></span>
            <span class="band tol" data-band="T" style="background:${COLORS.gold.hex};color:${COLORS.gold.hex}"></span>
          </div>
          <div class="lead right"></div>
        </div>
        <div class="card-label">R${i+1}</div>
        <div class="card-info">${COLORS[r.b1].name} · ${COLORS[r.b2].name} · ${COLORS[r.b3].name}</div>
        <div class="card-rc">${fmt(c.rc)} Ω ± ${fmt(c.drc)}</div>
      </div>`;
    }).join('');
    attachGalleryHandlers();
  }
  function attachGalleryHandlers(){
    document.querySelectorAll('.resistor-card').forEach(card=>{
      card.addEventListener('mousemove',e=>{
        const rect=card.getBoundingClientRect();
        const x=(e.clientX-rect.left)/rect.width-0.5,y=(e.clientY-rect.top)/rect.height-0.5;
        card.style.setProperty('--mx',`${(x+0.5)*100}%`); card.style.setProperty('--my',`${(y+0.5)*100}%`);
        card.style.transform=`rotateY(${x*24}deg) rotateX(${-y*20}deg) translateZ(12px)`;
        const b=card.querySelector('.resistor-3d'); if(b)b.style.transform=`translateZ(24px) rotateY(${x*8}deg) rotateX(${-y*6}deg)`;
      });
      card.addEventListener('mouseleave',()=>{card.style.transform=''; const b=card.querySelector('.resistor-3d'); if(b)b.style.transform='';});
      card.addEventListener('click',()=>{active=Number(card.dataset.index); updateResistorVisuals(); renderTable(); updateReadout();});
    });
  }
  function updateResistorVisuals(){
    document.querySelectorAll('.resistor-card').forEach(card=>{
      const i=Number(card.dataset.index),r=rows[i],c=calcRow(r);
      card.classList.toggle('active',i===active);
      const bands=card.querySelectorAll('.band');
      if(bands[0]){bands[0].style.background=COLORS[r.b1].hex;bands[0].style.color=COLORS[r.b1].hex;}
      if(bands[1]){bands[1].style.background=COLORS[r.b2].hex;bands[1].style.color=COLORS[r.b2].hex;}
      if(bands[2]){bands[2].style.background=COLORS[r.b3].hex;bands[2].style.color=COLORS[r.b3].hex;}
      const info=card.querySelector('.card-info'); if(info)info.textContent=`${COLORS[r.b1].name} · ${COLORS[r.b2].name} · ${COLORS[r.b3].name}`;
      const rc=card.querySelector('.card-rc'); if(rc)rc.textContent=`${fmt(c.rc)} Ω ± ${fmt(c.drc)}`;
    });
  }
  function renderColorControls(){
    const w=document.getElementById('colorControls');
    w.innerHTML=rows.map((r,i)=>`
      <div class="color-row" data-index="${i}">
        <div class="color-tag">R${i+1}</div>
        <label class="select-label">نوار ۱ <span class="select-wrap"><span class="swatch" data-field="b1"></span><select data-index="${i}" data-field="b1">${optionList(digitColors,r.b1)}</select></span></label>
        <label class="select-label">نوار ۲ <span class="select-wrap"><span class="swatch" data-field="b2"></span><select data-index="${i}" data-field="b2">${optionList(digitColors,r.b2)}</select></span></label>
        <label class="select-label">نوار ۳ / ضریب <span class="select-wrap"><span class="swatch" data-field="b3"></span><select data-index="${i}" data-field="b3">${optionList(multColors,r.b3)}</select></span></label>
        <div class="fixed-tol">نوار چهارم: <strong>طلایی ±۵٪</strong></div>
      </div>`).join('');
    rows.forEach((_,i)=>updateSwatches(i));
  }
  function updateSwatches(i){
    const row=document.querySelector(`.color-row[data-index="${i}"]`); if(!row)return;
    ['b1','b2','b3'].forEach(f=>{
      const sel=row.querySelector(`select[data-field="${f}"]`); const sw=row.querySelector(`.swatch[data-field="${f}"]`);
      if(sel&&sw){sw.style.background=COLORS[sel.value].hex;sw.style.color=COLORS[sel.value].hex;}
    });
  }

  /* ====== Tables ====== */
  function renderTable(){
    const tb=document.getElementById('tableBody'); if(!tb)return;
    tb.innerHTML=rows.map((r,i)=>{
      const c=calcRow(r);
      return `<div class="lab-block" data-index="${i}" style="margin-bottom:12px">
        <div style="font-weight:800;margin-bottom:6px;color:#dffcff">مقاومت R${i+1} <span class="mini-bands" style="display:inline-flex;vertical-align:middle;margin-right:8px">${bandSpan(r.b1)}${bandSpan(r.b2)}${bandSpan(r.b3)}${bandSpan('gold')}</span>
          <button class="row-pick" type="button" data-action="active" data-index="${i}" style="font-size:11px">انتخاب</button></div>
        <table class="block-table">
          <thead><tr><th>RC ± ΔRC (Ω)</th><th>RD ± ΔRD (Ω)</th><th>VE ± ΔVE (V)</th><th>IE ± ΔIE (A)</th><th>RE ± ΔRE (Ω)</th></tr></thead>
          <tbody><tr>
            <td class="auto">${fmt(c.rc)} ± ${fmt(c.drc)}</td>
            <td><input type="text" inputmode="decimal" data-index="${i}" data-field="rdStr" value="${r.rdStr}"> <span class="auto">± ${fmtAutoDelta(c.drd)}</span></td>
            <td><input type="text" inputmode="decimal" data-index="${i}" data-field="veStr" value="${r.veStr}"> <span class="auto">± ${fmtAutoDelta(c.dve)}</span></td>
            <td><input type="text" inputmode="decimal" data-index="${i}" data-field="ieStr" value="${r.ieStr}"> <span class="auto">± ${fmtAutoDelta(c.die)}</span></td>
            <td class="result-cell">${fmt(c.re)} ± ${fmt(c.dre)}</td>
          </tr></tbody>
        </table>
      </div>`;
    }).join('');
  }
  function updateRowComputed(i){
    const c=calcRow(rows[i]); const block=document.querySelector(`#tableBody .lab-block[data-index="${i}"]`); if(!block)return;
    const autos=block.querySelectorAll('.auto');
    const result=block.querySelector('.result-cell');
    // RC, ΔRD display near input, ΔVE, ΔIE, RE
    const cells=block.querySelectorAll('td');
    if(cells[0]) cells[0].textContent=`${fmt(c.rc)} ± ${fmt(c.drc)}`;
    if(cells[1]){ const sp=cells[1].querySelector('.auto'); if(sp) sp.textContent=`± ${fmtAutoDelta(c.drd)}`; }
    if(cells[2]){ const sp=cells[2].querySelector('.auto'); if(sp) sp.textContent=`± ${fmtAutoDelta(c.dve)}`; }
    if(cells[3]){ const sp=cells[3].querySelector('.auto'); if(sp) sp.textContent=`± ${fmtAutoDelta(c.die)}`; }
    if(result) result.textContent=`${fmt(c.re)} ± ${fmt(c.dre)}`;
  }
  function updateSeriesRowComputed(i){
    const c=calcSeriesRow(seriesRows[i]); const tb=document.getElementById('seriesTableBody'); if(!tb)return;
    const set=(k,val)=>{ const el=tb.querySelector(`[data-k="${k}"]`); if(el) el.textContent=val; };
    set('rs', `${fmt(c.rs)} ± ${fmtAutoDelta(c.drs)}`);
    set('vs', `${fmt(c.vs)} ± ${fmtAutoDelta(c.dvs)}`);
    set('re', `${fmt(c.re)} ± ${fmt(c.dre)}`);
    tb.querySelectorAll('td').forEach(td=>{
      const inp=td.querySelector('input'); const sp=td.querySelector('.auto');
      if(!inp||!sp)return;
      const f=inp.dataset.field;
      const map={r1Str:c.dr1,r2Str:c.dr2,v1Str:c.dv1,v2Str:c.dv2,veStr:c.dve,ieStr:c.die};
      if(map[f]!=null) sp.textContent=`± ${fmtAutoDelta(map[f])}`;
    });
  }
  function updateParallelRowComputed(i){
    const c=calcParallelRow(parallelRows[i]); const tb=document.getElementById('parallelTableBody'); if(!tb)return;
    const set=(k,val)=>{ const el=tb.querySelector(`[data-k="${k}"]`); if(el) el.textContent=val; };
    set('rp', `${fmt(c.rp)} ± ${fmtAutoDelta(c.drp)}`);
    set('ip', `${fmt(c.ip)} ± ${fmtAutoDelta(c.dip)}`);
    set('re', `${fmt(c.re)} ± ${fmt(c.dre)}`);
    tb.querySelectorAll('td').forEach(td=>{
      const inp=td.querySelector('input'); const sp=td.querySelector('.auto');
      if(!inp||!sp)return;
      const map={r1Str:c.dr1,r2Str:c.dr2,i1Str:c.di1,i2Str:c.di2,veStr:c.dve,ieStr:c.die};
      if(map[inp.dataset.field]!=null) sp.textContent=`± ${fmtAutoDelta(map[inp.dataset.field])}`;
    });
  }
  function updateExp4RowComputed(i){
    const c=calcExp4Row(exp4Rows[i]); const tb=document.getElementById('exp4TableBody'); if(!tb)return;
    const set=(k,val)=>{ const el=tb.querySelector(`[data-k="${k}"]`); if(el) el.textContent=val; };
    set('rc', `${fmt(c.rc)} ± ${fmtAutoDelta(c.drc)}`);
    set('re', `${fmt(c.re)} ± ${fmt(c.dre)}`);
    set('errRC', isFinite(c.errRC)?fmt(c.errRC,2):'—');
    set('errI3', isFinite(c.errI3)?fmt(c.errI3,2):'—');
    tb.querySelectorAll('td').forEach(td=>{
      const inp=td.querySelector('input'); const sp=td.querySelector('.auto');
      if(!inp||!sp)return;
      const map={r1Str:c.dr1,r2Str:c.dr2,r3Str:c.dr3,v1Str:c.dv1,v3Str:c.dv3,veStr:c.dve,i1Str:c.di1,i2Str:c.di2,i3Str:c.di3,ieStr:c.die};
      if(map[inp.dataset.field]!=null) sp.textContent=`± ${fmtAutoDelta(map[inp.dataset.field])}`;
    });
  }
  function renderSeriesTable(){
    const tb=document.getElementById('seriesTableBody'); if(!tb)return;
    const r=seriesRows[0], c=calcSeriesRow(r);
    tb.innerHTML=`
      <table class="block-table">
        <thead><tr><th>R₁ ± ΔR₁ (Ω)</th><th>R₂ ± ΔR₂ (Ω)</th><th>R<sub>s</sub> ± ΔR<sub>s</sub> (Ω)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r1Str" value="${r.r1Str}"> <span class="auto">± ${fmtAutoDelta(c.dr1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r2Str" value="${r.r2Str}"> <span class="auto">± ${fmtAutoDelta(c.dr2)}</span></td>
          <td class="result-cell auto" data-k="rs">${fmt(c.rs)} ± ${fmtAutoDelta(c.drs)}</td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>V₁ ± ΔV₁ (V)</th><th>V₂ ± ΔV₂ (V)</th><th>V<sub>s</sub> ± ΔV<sub>s</sub> (V)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="v1Str" value="${r.v1Str}"> <span class="auto">± ${fmtAutoDelta(c.dv1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="v2Str" value="${r.v2Str}"> <span class="auto">± ${fmtAutoDelta(c.dv2)}</span></td>
          <td class="result-cell auto" data-k="vs">${fmt(c.vs)} ± ${fmtAutoDelta(c.dvs)}</td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>V<sub>E</sub> ± ΔV<sub>E</sub> (V)</th><th>I<sub>E</sub> ± ΔI<sub>E</sub> (A)</th><th>R<sub>E</sub> ± ΔR<sub>E</sub> (Ω)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="veStr" value="${r.veStr}"> <span class="auto">± ${fmtAutoDelta(c.dve)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="ieStr" value="${r.ieStr}"> <span class="auto">± ${fmtAutoDelta(c.die)}</span></td>
          <td class="result-cell auto" data-k="re">${fmt(c.re)} ± ${fmt(c.dre)}</td>
        </tr></tbody>
      </table>`;
  }
