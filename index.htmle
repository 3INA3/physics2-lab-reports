      grid+=`<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT+plotH}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.1:0.5}"/>`;
      grid+=`<line x1="${padL}" y1="${y}" x2="${padL+plotW}" y2="${y}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.1:0.5}"/>`;
