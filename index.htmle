      labels+=`<text x="${padL-8}" y="${yOf(vv)+4}" fill="#0f172a" font-size="11" text-anchor="end" font-family="Courier New">${fmt(vv,g===10?0:1)}</text>`;
    }
    labels+=`<text x="${padL+plotW/2}" y="${H-12}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle">t (s)</text>`;
    labels+=`<text x="18" y="${padT+plotH/2}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle" transform="rotate(-90 18 ${padT+plotH/2})">Vc (V)</text>`;
    let curve='';
    if(isFinite(st.tau)&&st.tau>0&&isFinite(st.vm)&&st.vm>0){
      let d='';
      for(let i=0;i<=80;i++){
        const t=(i/80)*tMax;
        const v=st.vm*Math.exp(-t/st.tau);
        d+=(i===0?'M':'L')+` ${xOf(t)} ${yOf(v)} `;
      }
      curve=`<path d="${d}" fill="none" stroke="#2563eb" stroke-width="2"/>`;
    }
    let marker='';
    if(isFinite(st.target)&&isFinite(st.tau)){
      marker=`<line x1="${xOf(st.tau)}" y1="${yOf(st.target)}" x2="${xOf(st.tau)}" y2="${padT+plotH}" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="5 3"/>
        <line x1="${padL}" y1="${yOf(st.target)}" x2="${xOf(st.tau)}" y2="${yOf(st.target)}" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="5 3"/>
        <circle cx="${xOf(st.tau)}" cy="${yOf(st.target)}" r="5" fill="#f59e0b" stroke="#b45309" stroke-width="1.5"/>
        <text x="${xOf(st.tau)+8}" y="${yOf(st.target)-8}" fill="#b45309" font-size="12" font-weight="800" font-family="Courier New">τ=${fmt(st.tau)} s</text>`;
    }
    let scatter='';
    pts.forEach(p=>{
      scatter+=`<circle cx="${xOf(p.t)}" cy="${yOf(p.v)}" r="5" fill="#2563eb" stroke="#1e3a8a" stroke-width="1.4"/>`;
    });
    host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="background:#fff">
      <rect width="${W}" height="${H}" fill="#fff"/>
      ${grid}
      <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.4"/>
      <line x1="${padL}" y1="${padT+plotH}" x2="${padL+plotW}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.4"/>
      ${labels}${curve}${marker}${scatter}
    </svg>`;
    const info=document.getElementById('exp9ScaleInfo');
    if(info) info.innerHTML=`<span class="chip">محور افقی: t (s)</span><span class="chip">محور عمودی: Vc (V)</span><span class="chip">دشارژ: Vc=Vm e^(−t/τ)</span><span class="chip">τ از 0.37 Vm</span>`;
    const box=document.getElementById('exp9FitBox');
    if(box) box.innerHTML=`<div class="title">نتیجه تحلیل نمودار دشارژ</div>
      <span class="eq">Vm = ${isFinite(st.vm)?fmt(st.vm):'—'} V    |    0.37 Vm = ${isFinite(st.target)?fmt(st.target):'—'} V</span>
      <span class="eq">τ = ${isFinite(st.tau)?fmt(st.tau):'—'} ± ${isFinite(st.dtau)?fmt(st.dtau):'—'} s</span>
      <span class="eq">C_exp = τ/R = ${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>
      <span class="eq" style="font-weight:800;color:#61e7ff">C_exp = ${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>`;
  }
  function renderExp9Cards(){
    const w=document.getElementById('exp9Cards'); if(!w)return;
    const st=calcExp9Stats();
    w.innerHTML=`<article class="calc-card glass-inset">
      <div class="calc-head"><h3>دشارژ خازن</h3><span class="chip">آزمایش ۹</span></div>
      <div class="formula-box">
        <div class="title">فرمول‌های گزارش کار — آزمایش ۹</div>
        <span class="eq">Vc = Vm · e^(−t/τ)</span>
        <span class="eq">τ = RC    →    C = τ / R</span>
        <span class="eq">در t=τ : Vc = 0.37 Vm</span>
        <span class="eq">ΔC = C (Δτ/τ + ΔR/R)</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">τ=${isFinite(st.tau)?fmt(st.tau):'—'} s  |  C_exp=${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>
      </div>
    </article>`;
  }
  function refreshExp9All(){
    const vm=document.getElementById('exp9Vm'), r=document.getElementById('exp9R'), ct=document.getElementById('exp9Cth');
    if(vm) exp9Meta.vmStr=vm.value;
    if(r) exp9Meta.rStr=r.value;
    if(ct) exp9Meta.cthStr=ct.value;
    renderExp9Table(); renderExp9Graph(); renderExp9Cards();
  }


  function calcExp10Dc(row){
    const osc=parseNum(row.oscStr), met=parseNum(row.metStr);
    const dosc=autoDelta(row.oscStr), dmet=autoDelta(row.metStr);
    const err=(isFinite(osc)&&isFinite(met)&&met!==0)? Math.abs(osc-met)/Math.abs(met)*100 : NaN;
    return {osc,met,dosc,dmet,err};
  }
  function calcExp10Ac(){
    const a=exp10Ac;
    const t=parseNum(a.tStr); // period in s (user may enter ms - we accept as given)
    const ffg=parseNum(a.ffgStr);
    const nV=parseNum(a.nVStr), voltDiv=parseNum(a.voltDivStr);
    const nT=parseNum(a.nTStr), timeDiv=parseNum(a.timeDivStr);
    const vac=parseNum(a.vacStr);
    // If user enters T in ms field as number like 0.003 or 3 with note - we'll compute from divisions too
    let T = t;
    if(isFinite(nT)&&isFinite(timeDiv)) T = nT * timeDiv; // preferred from divisions
    let Vpp = NaN;
    if(isFinite(nV)&&isFinite(voltDiv)) Vpp = nV * voltDiv;
    const Vs = isFinite(Vpp)? Vpp/2 : NaN;
    const Vrms = isFinite(Vpp)? Vpp/(2*Math.SQRT2) : NaN;
    const fE = (isFinite(T)&&T!==0)? 1/T : NaN;
    const errF = (isFinite(fE)&&isFinite(ffg)&&ffg!==0)? Math.abs(ffg-fE)/Math.abs(ffg)*100 : NaN;
    const errV = (isFinite(Vrms)&&isFinite(vac)&&vac!==0)? Math.abs(Vrms-vac)/Math.abs(vac)*100 : NaN;
    return {T,Vpp,Vs,Vrms,fE,ffg,vac,errF,errV,nV,voltDiv,nT,timeDiv};
  }
  function renderExp10DcTable(){
    const tb=document.getElementById('exp10DcBody'); if(!tb)return;
    let h=`<table class="block-table"><thead><tr>
      <th>شماره</th>
      <th>V_DC ± Δ (اسیلوسکوپ)</th>
      <th>V′_DC ± Δ (ولت‌متر)</th>
      <th>|V−V′|/V′ × 100 (%)</th>
    </tr></thead><tbody>`;
    exp10Dc.forEach((r,i)=>{
      const c=calcExp10Dc(r);
      h+=`<tr>
        <td>${i+1}</td>
        <td><input type="text" inputmode="decimal" data-e10dc-i="${i}" data-e10dc-f="oscStr" value="${r.oscStr}"> <span class="auto">± ${fmtAutoDelta(c.dosc)}</span></td>
        <td><input type="text" inputmode="decimal" data-e10dc-i="${i}" data-e10dc-f="metStr" value="${r.metStr}"> <span class="auto">± ${fmtAutoDelta(c.dmet)}</span></td>
        <td class="result-cell">${isFinite(c.err)?fmt(c.err,2):'—'}</td>
      </tr>`;
    });
    h+=`</tbody></table>`;
    tb.innerHTML=h;
  }
  function renderExp10AcTable(){
    const tb=document.getElementById('exp10AcBody'); if(!tb)return;
    const a=exp10Ac;
    const c=calcExp10Ac();
    const inp=(f,v)=>`<input type="text" inputmode="decimal" data-e10ac-f="${f}" value="${v}">`;
    tb.innerHTML=`
      <table class="block-table">
        <thead><tr>
          <th>شکل موج</th>
          <th>تعداد خانه افقی (قله تا قله)</th>
          <th>Time/Div (s)</th>
          <th>T (s) = خانه×Time/Div</th>
          <th>f_E = 1/T (Hz)</th>
          <th>f_FG ژنراتور (Hz)</th>
          <th>|f_FG−f_E|/f_FG ×100 (%)</th>
        </tr></thead>
        <tbody><tr>
          <td><input type="text" data-e10ac-f="wave" value="${a.wave}"></td>
          <td>${inp('nTStr',a.nTStr)}</td>
          <td>${inp('timeDivStr',a.timeDivStr)}</td>
          <td class="result-cell">${isFinite(c.T)?fmt(c.T,6):'—'}</td>
          <td class="result-cell">${isFinite(c.fE)?fmt(c.fE,2):'—'}</td>
          <td>${inp('ffgStr',a.ffgStr)}</td>
          <td class="result-cell">${isFinite(c.errF)?fmt(c.errF,2):'—'}</td>
        </tr></tbody>
      </table>
      <table class="block-table" style="margin-top:10px">
        <thead><tr>
          <th>تعداد خانه عمودی (قله تا قله)</th>
          <th>Volt/Div (V)</th>
          <th>Vpp (V)</th>
          <th>Vs = Vpp/2</th>
          <th>Vrms = Vpp/(2√2)</th>
          <th>V_AC ولت‌متر (V)</th>
          <th>|Vrms−VAC|/VAC ×100 (%)</th>
        </tr></thead>
        <tbody><tr>
          <td>${inp('nVStr',a.nVStr)}</td>
          <td>${inp('voltDivStr',a.voltDivStr)}</td>
          <td class="result-cell">${isFinite(c.Vpp)?fmt(c.Vpp):'—'}</td>
          <td class="result-cell">${isFinite(c.Vs)?fmt(c.Vs):'—'}</td>
          <td class="result-cell">${isFinite(c.Vrms)?fmt(c.Vrms):'—'}</td>
          <td>${inp('vacStr',a.vacStr)}</td>
          <td class="result-cell">${isFinite(c.errV)?fmt(c.errV,2):'—'}</td>
        </tr></tbody>
      </table>
      <div class="table-note" style="margin-top:8px;font-size:12px;color:#9fb0c9">مثال جزوه: T=3 ms → 0.003 s ، Vpp=9.2 V ، Vrms≈2.25 V</div>`;
  }
  function renderExp10Cards(){
    const w=document.getElementById('exp10Cards'); if(!w)return;
    const c=calcExp10Ac();
    w.innerHTML=`<article class="calc-card glass-inset">
      <div class="calc-head"><h3>نوسان‌نما</h3><span class="chip">آزمایش ۱۰</span></div>
      <div class="formula-box">
        <div class="title">فرمول‌های گزارش کار — آزمایش ۱۰</div>
        <span class="eq">Vpp = (خانه‌های عمودی) × (Volt/Div) = ${isFinite(c.Vpp)?fmt(c.Vpp):'—'} V</span>
        <span class="eq">Vs = Vpp / 2 = ${isFinite(c.Vs)?fmt(c.Vs):'—'} V</span>
        <span class="eq">Vrms = Vpp / (2√2) = ${isFinite(c.Vrms)?fmt(c.Vrms):'—'} V</span>
        <span class="eq">T = (خانه‌های افقی) × (Time/Div) = ${isFinite(c.T)?fmt(c.T,6):'—'} s</span>
        <span class="eq">f_E = 1/T = ${isFinite(c.fE)?fmt(c.fE,2):'—'} Hz</span>
        <span class="eq">خطای فرکانس = ${isFinite(c.errF)?fmt(c.errF,2):'—'} %    |    خطای Vrms = ${isFinite(c.errV)?fmt(c.errV,2):'—'} %</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">Vrms=${isFinite(c.Vrms)?fmt(c.Vrms):'—'} V  |  f_E=${isFinite(c.fE)?fmt(c.fE,2):'—'} Hz</span>
      </div>
    </article>`;
  }
  function refreshExp10All(){ renderExp10DcTable(); renderExp10AcTable(); renderExp10Cards(); }

function renderAll(){
    const safe=(fn,name)=>{ try{ fn(); } catch(e){ console.warn('render fail', name||fn.name, e); } };
    safe(renderColorControls); safe(renderGallery); safe(renderTable);
    safe(renderSeriesTable); safe(renderParallelTable); safe(renderExp4Table); safe(renderExp5Table);
    safe(refreshExp6All); safe(refreshExp7All); safe(refreshExp8All); safe(refreshExp9All); safe(refreshExp10All);
    safe(renderCards); safe(renderSeriesCards); safe(renderParallelCards); safe(renderExp4Cards); safe(renderExp5Cards);
    safe(renderExtraGalleries); safe(updateReadout);
  }

  /* Tab switching */
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active',b===btn));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.toggle('active',p.id===btn.dataset.tab));
      window.scrollTo({top:0,behavior:'smooth'});
    });
  });

  /* Input events — partial updates so focus stays in the box */
  document.getElementById('colorControls')?.addEventListener('change',e=>{
    if(!e.target.matches('select'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    rows[idx][f]=e.target.value;
    updateSwatches(idx); updateResistorVisuals();
    renderTable(); renderCards(); updateReadout();
    // restore focus not needed on select change
  });
  document.getElementById('tableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    rows[idx][f]=e.target.value; updateRowComputed(idx); renderCards();
    if(idx===active)updateReadout();
  });
  document.getElementById('tableBody')?.addEventListener('click',e=>{
    const btn=e.target.closest('[data-action="active"]'); if(!btn)return;
    active=Number(btn.dataset.index); updateResistorVisuals(); updateReadout();
  });
  document.getElementById('seriesTableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    seriesRows[idx][f]=e.target.value; updateSeriesRowComputed(idx); renderSeriesCards();
  });
  document.getElementById('parallelTableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    parallelRows[idx][f]=e.target.value; updateParallelRowComputed(idx); renderParallelCards();
  });
  document.getElementById('exp4TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    exp4Rows[idx][f]=e.target.value; updateExp4RowComputed(idx); renderExp4Cards();
  });
  document.getElementById('exp5TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index),f=e.target.dataset.field;
    exp5Rows[idx][f]=e.target.value; updateExp5RowComputed(idx); renderExp5Cards();
  });

  
  document.getElementById('exp6TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const idx=Number(e.target.dataset.index), f=e.target.dataset.field;
    if(!Number.isFinite(idx) || !f) return;
    exp6Pts[idx][f]=e.target.value;
    // partial update row R without destroying inputs
    const c=calcExp6Point(exp6Pts[idx]);
    const tr=e.target.closest('tr');
    if(tr){
      const autos=tr.querySelectorAll('.auto');
      if(autos[0] && f==='vStr') autos[0].textContent=`± ${fmtAutoDelta(c.dv)}`;
      if(autos[1] && f==='iStr') autos[1].textContent=`± ${fmtAutoDelta(c.di)}`;
      // map by field
      tr.querySelectorAll('td').forEach(td=>{
        const inp=td.querySelector('input'); const sp=td.querySelector('.auto');
        if(inp&&sp){ if(inp.dataset.field==='vStr') sp.textContent=`± ${fmtAutoDelta(c.dv)}`; if(inp.dataset.field==='iStr') sp.textContent=`± ${fmtAutoDelta(c.di)}`; }
      });
      const res=tr.querySelector('.result-cell');
      if(res) res.textContent=`${isFinite(c.r)?fmt(c.r):'—'} ± ${isFinite(c.dr)?fmt(c.dr):'—'}`;
    }
    // update summary + graph + cards without wiping focused input
    const st=calcExp6Stats();
    const sum=document.getElementById('exp6Summary');
    if(sum){
      const cells=sum.querySelectorAll('.result-cell');
      if(cells[0]) cells[0].textContent=`${isFinite(st.rBar)?fmt(st.rBar):'—'} ± ${isFinite(st.drBar)?fmt(st.drBar):'—'}`;
      if(cells[1]) cells[1].textContent=`${isFinite(st.slope)?fmt(st.slope):'—'} ± ${isFinite(st.dSlope)?fmt(st.dSlope):'—'}`;
      // note: Rd is input in middle cell - structure has 3 cells: mean, rd input, slope
      const tds=sum.querySelectorAll('tbody td');
      if(tds[0]) tds[0].textContent=`${isFinite(st.rBar)?fmt(st.rBar):'—'} ± ${isFinite(st.drBar)?fmt(st.drBar):'—'}`;
      if(tds[2]) tds[2].textContent=`${isFinite(st.slope)?fmt(st.slope):'—'} ± ${isFinite(st.dSlope)?fmt(st.dSlope):'—'}`;
    }
    renderOhmGraph(); renderExp6Cards();
  });
  document.getElementById('exp6AddRow')?.addEventListener('click',()=>{
    exp6Pts.push({vStr:'',iStr:''}); refreshExp6All();
  });
  document.getElementById('exp6DelRow')?.addEventListener('click',()=>{
    if(exp6Pts.length>2){ exp6Pts.pop(); refreshExp6All(); }
  });

  
  document.getElementById('exp7TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const f=e.target.dataset.exp7Field;
    if(!f) return;
    exp7[f]=e.target.value;
    // partial: refresh computed cells via full table is ok for single row form
    refreshExp7All();
    // restore focus
    const again=document.querySelector(`#exp7TableBody input[data-exp7-field="${f}"]`);
    if(again){ again.focus(); const len=again.value.length; again.setSelectionRange(len,len); }
  });


  document.getElementById('exp8TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const i=+e.target.dataset.e8I, f=e.target.dataset.e8F;
    if(!Number.isFinite(i)||!f)return;
    exp8Pts[i][f]=e.target.value;
    refreshExp8All();
    const again=document.querySelector(`#exp8TableBody input[data-e8-i="${i}"][data-e8-f="${f}"]`);
    if(again){ again.focus(); const L=again.value.length; again.setSelectionRange(L,L); }
  });
  ['exp8Vm','exp8R','exp8Cth'].forEach(id=>{
    document.getElementById(id)?.addEventListener('input',()=>refreshExp8All());
  });
  document.getElementById('exp8AddRow')?.addEventListener('click',()=>{ exp8Pts.push({tStr:'',vStr:''}); refreshExp8All(); });
  document.getElementById('exp8DelRow')?.addEventListener('click',()=>{ if(exp8Pts.length>2){ exp8Pts.pop(); refreshExp8All(); } });
  document.getElementById('exp8Sample')?.addEventListener('click',()=>{
    exp8Meta.vmStr='5.99'; exp8Meta.rStr='100'; exp8Meta.cthStr='220';
    const vmEl=document.getElementById('exp8Vm'), rEl=document.getElementById('exp8R'), cEl=document.getElementById('exp8Cth');
    if(vmEl) vmEl.value='5.99'; if(rEl) rEl.value='100'; if(cEl) cEl.value='220';
    // sample absolute voltages matching shape of PDF (positive charging)
    const sample=[[0.45,0.29],[0.96,0.49],[1.54,0.78],[2.69,1.06],[3.65,1.23],[4.70,1.48],[5.75,1.64],[7.62,2.00],[10.57,2.46],[13.94,2.92],[16.46,3.22],[21.04,3.69],[26.51,4.14],[32.63,4.54],[40.50,4.91],[48.43,5.18],[56.55,5.38],[63.70,5.51],[70.27,5.61],[79.95,5.70],[88.62,5.76],[98.78,5.81],[112.50,5.86],[136.77,5.90],[168.78,5.92]];
    exp8Pts=sample.map(([t,v])=>({tStr:String(t),vStr:String(v)}));
    refreshExp8All();
  });


  document.getElementById('exp9TableBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const i=+e.target.dataset.e9I, f=e.target.dataset.e9F;
    if(!Number.isFinite(i)||!f)return;
    exp9Pts[i][f]=e.target.value;
    refreshExp9All();
    const again=document.querySelector(`#exp9TableBody input[data-e9-i="${i}"][data-e9-f="${f}"]`);
    if(again){ again.focus(); const L=again.value.length; again.setSelectionRange(L,L); }
  });
  ['exp9Vm','exp9R','exp9Cth'].forEach(id=>{
    document.getElementById(id)?.addEventListener('input',()=>refreshExp9All());
  });
  document.getElementById('exp9AddRow')?.addEventListener('click',()=>{ exp9Pts.push({tStr:'',vStr:''}); refreshExp9All(); });
  document.getElementById('exp9DelRow')?.addEventListener('click',()=>{ if(exp9Pts.length>2){ exp9Pts.pop(); refreshExp9All(); } });
  document.getElementById('exp9Sample')?.addEventListener('click',()=>{
    exp9Meta.vmStr='5.99'; exp9Meta.rStr='100'; exp9Meta.cthStr='220';
    const vmEl=document.getElementById('exp9Vm'), rEl=document.getElementById('exp9R'), cEl=document.getElementById('exp9Cth');
    if(vmEl) vmEl.value='5.99'; if(rEl) rEl.value='100'; if(cEl) cEl.value='220';
    const sample=[[1.20,5.58],[2.27,5.28],[3.67,5.01],[5.67,4.58],[8.64,4.05],[11.31,3.58],[14.58,3.17],[18.94,2.66],[25.29,2.02],[31.48,1.56],[34.02,1.41],[37.73,1.21],[42.55,1.00],[48.2,0.81],[52.25,0.68],[56.34,0.58],[67.40,0.36],[74.05,0.29],[83.31,0.20],[94.11,0.14]];
    exp9Pts=sample.map(([t,v])=>({tStr:String(t),vStr:String(v)}));
    refreshExp9All();
  });


  document.getElementById('exp10DcBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const i=+e.target.dataset.e10dcI, f=e.target.dataset.e10dcF;
    if(!Number.isFinite(i)||!f)return;
    exp10Dc[i][f]=e.target.value;
    refreshExp10All();
    const again=document.querySelector(`#exp10DcBody input[data-e10dc-i="${i}"][data-e10dc-f="${f}"]`);
    if(again){ again.focus(); const L=again.value.length; again.setSelectionRange(L,L); }
  });
  document.getElementById('exp10AcBody')?.addEventListener('input',e=>{
    if(!e.target.matches('input'))return;
    const f=e.target.dataset.e10acF;
    if(!f)return;
    exp10Ac[f]=e.target.value;
    refreshExp10All();
    const again=document.querySelector(`#exp10AcBody input[data-e10ac-f="${f}"]`);
    if(again){ again.focus(); const L=again.value.length; again.setSelectionRange(L,L); }
  });
  document.getElementById('exp10AddDc')?.addEventListener('click',()=>{ exp10Dc.push({oscStr:'',metStr:''}); refreshExp10All(); });
  document.getElementById('exp10DelDc')?.addEventListener('click',()=>{ if(exp10Dc.length>1){ exp10Dc.pop(); refreshExp10All(); } });

document.getElementById('resetBtn')?.addEventListener('click',()=>{
    rows=initialRows.map(r=>({...r}));
    seriesRows=initialSeries.map(r=>({...r}));
    parallelRows=initialParallel.map(r=>({...r}));
    exp4Rows=initialExp4.map(r=>({...r}));
    exp5Rows=initialExp5.map(r=>({...r}));
    exp6Pts=initialExp6Pts.map(r=>({...r})); exp6Meta={rdStr:'0', b1:'blue', b2:'gray', b3:'red'}; exp7={...initialExp7};
    active=0; renderAll(); initExtraColorControls();
  });
  document.getElementById('printBtn')?.addEventListener('click',()=>{window.print();});

  /* 3D circuit rotation */
  const stage=document.getElementById('circuitStage'); const circuit=document.getElementById('circuit3d');
  if(stage&&circuit){
    let baseY=0,dragVel=0,isDragging=false,lastX=0,phase=0;
    const AMPLITUDE=26,SPEED=0.006;
    function animate(){
      if(!isDragging)phase+=SPEED;
      const autoY=Math.sin(phase)*AMPLITUDE; const autoX=12+Math.sin(phase*0.65)*3;
      baseY+=dragVel; dragVel*=0.92; if(Math.abs(dragVel)<0.01)dragVel=0;
      circuit.style.transform=`rotateX(${autoX}deg) rotateY(${autoY+baseY}deg)`;
      requestAnimationFrame(animate);
    }
    animate();
    stage.addEventListener('mousedown',e=>{isDragging=true;lastX=e.clientX;dragVel=0;e.preventDefault();});
    window.addEventListener('mousemove',e=>{if(!isDragging)return;const dx=e.clientX-lastX;lastX=e.clientX;baseY+=dx*0.45;dragVel=dx*0.12;});
    window.addEventListener('mouseup',()=>{isDragging=false;});
    stage.addEventListener('touchstart',e=>{if(e.touches.length!==1)return;isDragging=true;lastX=e.touches[0].clientX;dragVel=0;},{passive:true});
    window.addEventListener('touchmove',e=>{if(!isDragging||e.touches.length!==1)return;const dx=e.touches[0].clientX-lastX;lastX=e.touches[0].clientX;baseY+=dx*0.45;dragVel=dx*0.12;},{passive:true});
    window.addEventListener('touchend',()=>{isDragging=false;});
    const rb=document.getElementById('resetRotBtn'); if(rb)rb.addEventListener('click',()=>{baseY=0;dragVel=0;phase=0;});
  }



  function make3dResistorCard(label, b1, b2, b3){
    return `<div class="resistor-card" style="cursor:default">
      <div class="resistor-3d">
        <span class="lead left"></span>
        <div class="resistor-body">
          <span class="band" style="background:${COLORS[b1].hex}; left:18%"></span>
          <span class="band" style="background:${COLORS[b2].hex}; left:38%"></span>
          <span class="band" style="background:${COLORS[b3].hex}; left:58%"></span>
          <span class="band tol" style="background:${COLORS.gold.hex}; left:78%"></span>
        </div>
        <span class="lead right"></span>
      </div>
      <div class="card-info" style="text-align:center;margin-top:10px;font-weight:800;color:#e9fbff">${label}</div>
      <div class="card-info" style="text-align:center;font-size:11px;color:#9fb0c9">${COLORS[b1].name} · ${COLORS[b2].name} · ${COLORS[b3].name} · طلایی</div>
    </div>`;
  }
  function renderExtraGalleries(){
    const s=seriesRows[0];
    const sg=document.getElementById('seriesGallery3d');
    if(sg) sg.innerHTML = make3dResistorCard('R₁',s.r1b1,s.r1b2,s.r1b3)+make3dResistorCard('R₂',s.r2b1,s.r2b2,s.r2b3);
    const p=parallelRows[0];
    const pg=document.getElementById('parallelGallery3d');
    if(pg) pg.innerHTML = make3dResistorCard('R₁',p.r1b1,p.r1b2,p.r1b3)+make3dResistorCard('R₂',p.r2b1,p.r2b2,p.r2b3);
    const e4=exp4Rows[0];
    const g4=document.getElementById('exp4Gallery3d');
    if(g4) g4.innerHTML = make3dResistorCard('R₁',e4.r1b1,e4.r1b2,e4.r1b3)+make3dResistorCard('R₂',e4.r2b1,e4.r2b2,e4.r2b3)+make3dResistorCard('R₃',e4.r3b1,e4.r3b2,e4.r3b3);
    const e5=exp5Rows[0];
    const g5=document.getElementById('exp5Gallery3d');
    if(g5) g5.innerHTML = make3dResistorCard('R₁',e5.r1b1,e5.r1b2,e5.r1b3)+make3dResistorCard('R₂',e5.r2b1,e5.r2b2,e5.r2b3)+make3dResistorCard('Rₓ',e5.r3b1,e5.r3b2,e5.r3b3);
    const g7=document.getElementById('exp7Gallery3d');
    if(g7) g7.innerHTML = make3dResistorCard('R₁',exp7.r1b1,exp7.r1b2,exp7.r1b3)+make3dResistorCard('R₂',exp7.r2b1,exp7.r2b2,exp7.r2b3)+make3dResistorCard('R₃',exp7.r3b1,exp7.r3b2,exp7.r3b3);
  }

  /* Extra color controls for exp 2/3/4 */
  function fillBandSelects(rootSel, prefix, ri, bandsObj){
    const root=document.querySelector(rootSel); if(!root)return;
    root.querySelectorAll(`select[${prefix}="${ri}"]`).forEach(sel=>{
      const band=sel.dataset.band;
      const list = band==='b3' ? multColors : digitColors;
      const key = `r${ri}${band}`;
      const cur = bandsObj[key] || 'black';
      sel.innerHTML = list.map(c=>`<option value="${c}" ${c===cur?'selected':''}>${COLORS[c].name}</option>`).join('');
    });
    const bandsEl=document.getElementById(rootSel.replace('#','').replace('ColorControls','Bands')+ri) 
      || document.getElementById((prefix.includes('series')?'series':prefix.includes('parallel')?'parallel':'exp4')+'Bands'+ri);
    // fixed ids
  }
  function refreshExtraBands(kind){
    if(kind==='series'){
      const r=seriesRows[0];
      [1,2].forEach(i=>{
        const el=document.getElementById('seriesBands'+i);
        if(el) el.innerHTML = bandSpan(r['r'+i+'b1'])+bandSpan(r['r'+i+'b2'])+bandSpan(r['r'+i+'b3'])+bandSpan('gold');
      });
    } else if(kind==='parallel'){
      const r=parallelRows[0];
      [1,2].forEach(i=>{
        const el=document.getElementById('parallelBands'+i);
        if(el) el.innerHTML = bandSpan(r['r'+i+'b1'])+bandSpan(r['r'+i+'b2'])+bandSpan(r['r'+i+'b3'])+bandSpan('gold');
      });
    } else if(kind==='exp4'){
      const r=exp4Rows[0];
      [1,2,3].forEach(i=>{
        const el=document.getElementById('exp4Bands'+i);
        if(el) el.innerHTML = bandSpan(r['r'+i+'b1'])+bandSpan(r['r'+i+'b2'])+bandSpan(r['r'+i+'b3'])+bandSpan('gold');
      });
    } else if(kind==='exp5'){
      const r=exp5Rows[0];
      [1,2,3].forEach(i=>{
        const el=document.getElementById('exp5Bands'+i);
        if(el) el.innerHTML = bandSpan(r['r'+i+'b1'])+bandSpan(r['r'+i+'b2'])+bandSpan(r['r'+i+'b3'])+bandSpan('gold');
      });
    }
    renderExtraGalleries();
  }
  function initExtraColorControls(){
    const fill = (containerId, attr, rowsArr, count)=>{
      const root=document.getElementById(containerId); if(!root)return;
      for(let ri=1; ri<=count; ri++){
        root.querySelectorAll(`select[${attr}="${ri}"]`).forEach(sel=>{
          const band=sel.dataset.band;
          const list = band==='b3' ? multColors : digitColors;
          const key = 'r'+ri+band;
          const cur = rowsArr[0][key] || 'black';
          sel.innerHTML = list.map(c=>`<option value="${c}" ${c===cur?'selected':''}>${COLORS[c].name}</option>`).join('');
        });
      }
    };
    fill('seriesColorControls','data-series-r',seriesRows,2);
    fill('parallelColorControls','data-parallel-r',parallelRows,2);
    fill('exp4ColorControls','data-exp4-r',exp4Rows,3);
    fill('exp5ColorControls','data-exp5-r',exp5Rows,3);
    // exp6 uses exp6Meta
    (function(){ const root=document.getElementById('exp6ColorControls'); if(!root)return;
      root.querySelectorAll('select[data-exp6-r]').forEach(sel=>{ const band=sel.dataset.band; const list=band==='b3'?multColors:digitColors; const cur=exp6Meta[band]||'black'; sel.innerHTML=list.map(c=>`<option value="${c}" ${c===cur?'selected':''}>${COLORS[c].name}</option>`).join(''); });
      const el=document.getElementById('exp6Bands1'); if(el) el.innerHTML=bandSpan(exp6Meta.b1)+bandSpan(exp6Meta.b2)+bandSpan(exp6Meta.b3)+bandSpan('gold');
      const g=document.getElementById('exp6Gallery3d'); if(g) g.innerHTML=make3dResistorCard('R',exp6Meta.b1,exp6Meta.b2,exp6Meta.b3);
      root.onchange=e=>{ if(!e.target.matches('select'))return; exp6Meta[e.target.dataset.band]=e.target.value; const el=document.getElementById('exp6Bands1'); if(el) el.innerHTML=bandSpan(exp6Meta.b1)+bandSpan(exp6Meta.b2)+bandSpan(exp6Meta.b3)+bandSpan('gold'); const g=document.getElementById('exp6Gallery3d'); if(g) g.innerHTML=make3dResistorCard('R',exp6Meta.b1,exp6Meta.b2,exp6Meta.b3); };
    })();
    refreshExtraBands('series'); refreshExtraBands('parallel'); refreshExtraBands('exp4'); refreshExtraBands('exp5'); renderExtraGalleries();

    const bind=(containerId, attr, rowsArr, kind)=>{
      const root=document.getElementById(containerId); if(!root)return;
      root.addEventListener('change',e=>{
        if(!e.target.matches('select'))return;
        const ri=e.target.getAttribute(attr);
        const band=e.target.dataset.band;
        if(!ri||!band)return;
        rowsArr[0]['r'+ri+band]=e.target.value;
        refreshExtraBands(kind);
      });
    };
    bind('seriesColorControls','data-series-r',seriesRows,'series');
    bind('parallelColorControls','data-parallel-r',parallelRows,'parallel');
    bind('exp4ColorControls','data-exp4-r',exp4Rows,'exp4');
    bind('exp5ColorControls','data-exp5-r',exp5Rows,'exp5');
  }
  initExtraColorControls();
  (function(){
    const root=document.getElementById('exp7ColorControls'); if(!root)return;
    function paint(){
      [1,2,3].forEach(i=>{
        const el=document.getElementById('exp7Bands'+i);
        if(el) el.innerHTML=bandSpan(exp7['r'+i+'b1'])+bandSpan(exp7['r'+i+'b2'])+bandSpan(exp7['r'+i+'b3'])+bandSpan('gold');
      });
      const g=document.getElementById('exp7Gallery3d');
      if(g) g.innerHTML=make3dResistorCard('R₁',exp7.r1b1,exp7.r1b2,exp7.r1b3)+make3dResistorCard('R₂',exp7.r2b1,exp7.r2b2,exp7.r2b3)+make3dResistorCard('R₃',exp7.r3b1,exp7.r3b2,exp7.r3b3);
    }
    root.querySelectorAll('select[data-exp7-r]').forEach(sel=>{
      const ri=sel.dataset.exp7R, band=sel.dataset.band;
      const list=band==='b3'?multColors:digitColors;
      const key='r'+ri+band;
      const cur=exp7[key]||'black';
      sel.innerHTML=list.map(c=>`<option value="${c}" ${c===cur?'selected':''}>${COLORS[c].name}</option>`).join('');
    });
    root.addEventListener('change',e=>{
      if(!e.target.matches('select'))return;
      const ri=e.target.dataset.exp7R, band=e.target.dataset.band;
      exp7['r'+ri+band]=e.target.value;
      paint();
    });
    paint();
  })();
  renderAll();

</script>

