        <div class="cap">
          <div class="cap-row"><b>R₁∥R₂</b> دو مقاومت موازی</div>
          <div class="cap-row"><b>R₃</b> مقاومت سری با مجموعه</div>
          <div class="cap-row"><b>A₁ / A₂</b> آمپرمتر هر شاخه</div>
          <div class="cap-row"><b>A_E</b> آمپرمتر کل = I₃</div>
          <div class="cap-row gold"><b>V₁₂</b> ولتاژ دو سر موازی</div>
          <div class="cap-row gold"><b>V₃</b> ولتاژ دو سر R₃</div>
          <div class="cap-row gold"><b>V_E</b> ولتاژ کل مدار</div>
          <div class="cap-row violet"><b>I_E = I₁ + I₂</b></div>
        </div>
      </div>
    </section>
<section class="panel glass">

