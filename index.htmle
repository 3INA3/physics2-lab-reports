        <tbody><tr>
          <td class="result-cell">${isFinite(st.target)?fmt(st.target):'—'}</td>
          <td class="result-cell">${isFinite(st.tau)?fmt(st.tau):'—'} ± ${isFinite(st.dtau)?fmt(st.dtau):'—'}</td>
          <td class="result-cell">${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'}</td>
          <td>${isFinite(st.cth)?fmt(st.cth):'—'}</td>
          <td class="result-cell">${(isFinite(st.cexp)&&isFinite(st.cth)&&st.cth)?fmt(Math.abs(st.cth-st.cexp)/Math.abs(st.cth)*100,2):'—'}</td>
