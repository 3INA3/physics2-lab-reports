        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>V₁=V₂ ± Δ (V)</th><th>V₃ ± Δ (V)</th><th>V<sub>E</sub> ± Δ (V)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="v1Str" value="${r.v1Str}"> <span class="auto">± ${fmtAutoDelta(c.dv1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="v3Str" value="${r.v3Str}"> <span class="auto">± ${fmtAutoDelta(c.dv3)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="veStr" value="${r.veStr}"> <span class="auto">± ${fmtAutoDelta(c.dve)}</span></td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>I₁ ± Δ (mA)</th><th>I₂ ± Δ (mA)</th><th>I₃ ± Δ (mA)</th><th>I<sub>E</sub> ± Δ (mA)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="i1Str" value="${r.i1Str}"> <span class="auto">± ${fmtAutoDelta(c.di1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="i2Str" value="${r.i2Str}"> <span class="auto">± ${fmtAutoDelta(c.di2)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="i3Str" value="${r.i3Str}"> <span class="auto">± ${fmtAutoDelta(c.di3)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="ieStr" value="${r.ieStr}"> <span class="auto">± ${fmtAutoDelta(c.die)}</span></td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>R<sub>E</sub> ± ΔR<sub>E</sub> (KΩ)</th><th>|R<sub>C</sub>−R<sub>E</sub>|/R<sub>C</sub>×100 (%)</th><th>|I₃−I<sub>E</sub>|/I₃×100 (%)</th></tr></thead>
        <tbody><tr>
          <td class="result-cell auto" data-k="re">${fmt(c.re)} ± ${fmt(c.dre)}</td>
          <td class="result-cell auto" data-k="errRC">${isFinite(c.errRC)?fmt(c.errRC,2):'—'}</td>
          <td class="result-cell auto" data-k="errI3">${isFinite(c.errI3)?fmt(c.errI3,2):'—'}</td>
        </tr></tbody>
      </table>`;
  }

  /* ====== Calc Cards ====== */
  function renderCards(){
    const w=document.getElementById('calcCards'); if(!w)return;
    w.innerHTML=rows.map((r,i)=>{
      const c=calcRow(r); const mStr=fmt(c.m,0);
      return `<article class="calc-card glass-inset">
        <div class="calc-head"><h3>مقاومت R${i+1}</h3><span class="chip">${COLORS[r.b1].name} / ${COLORS[r.b2].name} / ${COLORS[r.b3].name} + طلایی</span></div>
        <div class="formula-box">
          <div class="title">فرمول‌های گزارش کار — آزمایش ۱</div>
          <span class="eq">R_C = (d₁×10 + d₂) × 10^{m} = (${c.d1}×10 + ${c.d2}) × ${mStr} = ${fmt(c.rc)} Ω</span>
          <span class="eq">ΔR_C = 5% × R_C = 0.05 × ${fmt(c.rc)} = ${fmt(c.drc)} Ω</span>
          <span class="eq">R_E = V_E / I_E = ${r.veStr} / ${r.ieStr} = ${fmt(c.re)} Ω</span>
          <span class="eq">ΔR_E = R_E × (ΔV_E/V_E + ΔI_E/I_E) = ${fmt(c.re)} × (${fmtAutoDelta(c.dve)}/${r.veStr} + ${fmtAutoDelta(c.die)}/${r.ieStr}) = ${fmt(c.dre)} Ω</span>
          <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه: R_E = ${fmt(c.re)} ± ${fmt(c.dre)} Ω    |    R_C = ${fmt(c.rc)} ± ${fmt(c.drc)} Ω</span>
        </div>
      </article>`;
    }).join('');
  }
  function renderSeriesCards(){
    const w=document.getElementById('seriesCards'); if(!w)return;
    w.innerHTML=seriesRows.map((r,i)=>{
      const c=calcSeriesRow(r);
      return `<article class="calc-card glass-inset">
        <div class="calc-head"><h3>مقاومت‌های سری</h3><span class="chip">آزمایش ۲</span></div>
        <div class="formula-box">
          <div class="title">فرمول‌های گزارش کار — آزمایش ۲ (سری)</div>
          <span class="eq">R_s = R₁ + R₂ = ${r.r1Str} + ${r.r2Str} = ${fmt(c.rs)} Ω</span>
          <span class="eq">ΔR_s = ΔR₁ + ΔR₂ = ${fmtAutoDelta(c.dr1)} + ${fmtAutoDelta(c.dr2)} = ${fmtAutoDelta(c.drs)} Ω</span>
          <span class="eq">V_s = V₁ + V₂ = ${r.v1Str} + ${r.v2Str} = ${fmt(c.vs)} V</span>
          <span class="eq">R_E = V_E / I_E = ${r.veStr} / ${r.ieStr} = ${fmt(c.re)} Ω</span>
          <span class="eq">ΔR_E = R_E (ΔV_E/V_E + ΔI_E/I_E) = ${fmt(c.re)} × (${fmtAutoDelta(c.dve)}/${r.veStr} + ${fmtAutoDelta(c.die)}/${r.ieStr}) = ${fmt(c.dre)} Ω</span>
          <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه: R_s = ${fmt(c.rs)} ± ${fmtAutoDelta(c.drs)} Ω    |    R_E = ${fmt(c.re)} ± ${fmt(c.dre)} Ω</span>
        </div>
      </article>`;
    }).join('');
  }
  function renderParallelCards(){
    const w=document.getElementById('parallelCards'); if(!w)return;
    w.innerHTML=parallelRows.map((r,i)=>{
      const c=calcParallelRow(r);
      return `<article class="calc-card glass-inset">
        <div class="calc-head"><h3>مقاومت‌های موازی</h3><span class="chip">آزمایش ۳</span></div>
        <div class="formula-box">
          <div class="title">فرمول‌های گزارش کار — آزمایش ۳ (موازی)</div>
          <span class="eq">R_p = (R₁·R₂)/(R₁+R₂) = (${r.r1Str}·${r.r2Str})/(${r.r1Str}+${r.r2Str}) = ${fmt(c.rp)} Ω</span>
          <span class="eq">ΔR_p ≈ R_p² · (ΔR₁/R₁² + ΔR₂/R₂²) = ${fmtAutoDelta(c.drp)} Ω</span>
          <span class="eq">I_p = I₁ + I₂ = ${r.i1Str} + ${r.i2Str} = ${fmt(c.ip)} A</span>
          <span class="eq">R_E = V_E / I_E = ${r.veStr} / ${r.ieStr} = ${fmt(c.re)} Ω</span>
          <span class="eq">ΔR_E = R_E (ΔV_E/V_E + ΔI_E/I_E) = ${fmt(c.dre)} Ω</span>
          <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه: R_p = ${fmt(c.rp)} ± ${fmtAutoDelta(c.drp)} Ω    |    R_E = ${fmt(c.re)} ± ${fmt(c.dre)} Ω</span>
        </div>
      </article>`;
    }).join('');
  }
  function renderExp4Cards(){
    const w=document.getElementById('exp4Cards'); if(!w)return;
    w.innerHTML=exp4Rows.map((r,i)=>{
      const c=calcExp4Row(r);
      return `<article class="calc-card glass-inset">
        <div class="calc-head"><h3>مدار ترکیبی</h3><span class="chip">آزمایش ۴</span></div>
        <div class="formula-box">
          <div class="title">فرمول‌های گزارش کار — آزمایش ۴ (ترکیبی)</div>
          <span class="eq">R_p = (R₁·R₂)/(R₁+R₂) = ${fmt(c.rp)} KΩ</span>
          <span class="eq">R_C = R_p + R₃ = ${fmt(c.rp)} + ${r.r3Str} = ${fmt(c.rc)} KΩ</span>
          <span class="eq">ΔR_C = ΔR_p + ΔR₃ = ${fmtAutoDelta(c.drc)} KΩ</span>
          <span class="eq">R_E = V_E / I_E = ${r.veStr} / ${r.ieStr} = ${fmt(c.re)} KΩ</span>
          <span class="eq">ΔR_E = R_E (ΔV_E/V_E + ΔI_E/I_E) = ${fmt(c.dre)} KΩ</span>
          <span class="eq">خطای مقاومت: |R_C − R_E|/R_C × 100 = ${isFinite(c.errRC)?fmt(c.errRC,2):'—'} %</span>
          <span class="eq">خطای جریان: |I₃ − I_E|/I₃ × 100 = ${isFinite(c.errI3)?fmt(c.errI3,2):'—'} %</span>
          <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه: R_C = ${fmt(c.rc)} ± ${fmtAutoDelta(c.drc)} KΩ    |    R_E = ${fmt(c.re)} ± ${fmt(c.dre)} KΩ</span>
        </div>
      </article>`;
    }).join('');
  }

  function updateReadout(){
    const r=rows[active],c=calcRow(r);
    const ve=document.getElementById('readoutVE'),ie=document.getElementById('readoutIE'),re=document.getElementById('readoutRE');
    if(ve)ve.innerHTML=`${r.veStr} V <span class="pm">± ${fmtAutoDelta(c.dve)}</span>`;
    if(ie)ie.innerHTML=`${r.ieStr} A <span class="pm">± ${fmtAutoDelta(c.die)}</span>`;
    if(re)re.innerHTML=`${fmt(c.re)} Ω <span class="pm">± ${fmt(c.dre)}</span>`;
  }

  
  function renderExp5Table(){
    const tb=document.getElementById('exp5TableBody'); if(!tb)return;
    const r=exp5Rows[0], c=calcExp5Row(r);
    tb.innerHTML=`
      <table class="block-table">
        <thead><tr><th>R₁ ± ΔR₁ (KΩ)</th><th>R₂ ± ΔR₂ (KΩ)</th><th>Rₓ th ± Δ (KΩ)</th><th>R' ± ΔR' (KΩ)</th></tr></thead>
        <tbody><tr>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r1Str" value="${r.r1Str}"> <span class="auto">± ${fmtAutoDelta(c.dr1)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="r2Str" value="${r.r2Str}"> <span class="auto">± ${fmtAutoDelta(c.dr2)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="rxthStr" value="${r.rxthStr}"> <span class="auto">± ${fmtAutoDelta(c.drxth)}</span></td>
          <td><input type="text" inputmode="decimal" data-index="0" data-field="rpStr" value="${r.rpStr}"> <span class="auto">± ${fmtAutoDelta(c.drp)}</span></td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>Rₓ exp ± ΔRₓ exp (KΩ)</th><th>|Rₓ th − Rₓ exp| / Rₓ th × 100 (%)</th></tr></thead>
        <tbody><tr>
          <td class="result-cell auto" data-k="rxexp">${isFinite(c.rxexp)?fmt(c.rxexp):'—'} ± ${isFinite(c.drxexp)?fmt(c.drxexp):'—'}</td>
          <td class="result-cell auto" data-k="err">${isFinite(c.err)?fmt(c.err,2):'—'}</td>
        </tr></tbody>
      </table>`;
  }
  function updateExp5RowComputed(i){
    const c=calcExp5Row(exp5Rows[i]); const tb=document.getElementById('exp5TableBody'); if(!tb)return;
    const set=(k,val)=>{ const el=tb.querySelector(`[data-k="${k}"]`); if(el) el.textContent=val; };
    set('rxexp', `${isFinite(c.rxexp)?fmt(c.rxexp):'—'} ± ${isFinite(c.drxexp)?fmt(c.drxexp):'—'}`);
    set('err', isFinite(c.err)?fmt(c.err,2):'—');
    tb.querySelectorAll('td').forEach(td=>{
      const inp=td.querySelector('input'); const sp=td.querySelector('.auto');
      if(!inp||!sp)return;
      const map={r1Str:c.dr1,r2Str:c.dr2,rxthStr:c.drxth,rpStr:c.drp};
      if(map[inp.dataset.field]!=null) sp.textContent=`± ${fmtAutoDelta(map[inp.dataset.field])}`;
    });
  }
  function renderExp5Cards(){
    const w=document.getElementById('exp5Cards'); if(!w)return;
    w.innerHTML=exp5Rows.map((r,i)=>{
      const c=calcExp5Row(r);
      return `<article class="calc-card glass-inset">
        <div class="calc-head"><h3>پل وتسون</h3><span class="chip">آزمایش ۵</span></div>
        <div class="formula-box">
          <div class="title">فرمول‌های گزارش کار — آزمایش ۵ (پل وتسون)</div>
          <span class="eq">در تعادل: V_D = V_C  ⇒  I_G = 0</span>
          <span class="eq">R₁ / Rₓ = R₂ / R'   ⇒   Rₓ exp = (R₁ / R₂) · R'</span>
          <span class="eq">Rₓ exp = (${r.r1Str} / ${r.r2Str}) · ${r.rpStr} = ${isFinite(c.rxexp)?fmt(c.rxexp):'—'} KΩ</span>
          <span class="eq">ΔRₓ exp = Rₓ exp · (ΔR₁/R₁ + ΔR₂/R₂ + ΔR'/R') = ${isFinite(c.drxexp)?fmt(c.drxexp):'—'} KΩ</span>
          <span class="eq">درصد خطا = |Rₓ th − Rₓ exp| / Rₓ th × 100 = ${isFinite(c.err)?fmt(c.err,2):'—'} %</span>
          <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه: Rₓ exp = ${isFinite(c.rxexp)?fmt(c.rxexp):'—'} ± ${isFinite(c.drxexp)?fmt(c.drxexp):'—'} KΩ</span>
        </div>
      </article>`;
    }).join('');
  }


  function calcExp6Point(p){
    const v=parseNum(p.vStr), i=parseNum(p.iStr);
    const dv=autoDelta(p.vStr), di=autoDelta(p.iStr);
    const r = (i!==0 && isFinite(v/i)) ? v/i : NaN;
    // if I in mA and want R in kΩ: R(kΩ)=V/I(mA). If both SI, R=V/I in Ω.
    // جزوه uses V in V, I in mA, R in kΩ → R = V/I
    const dr = (isFinite(r) && v && i) ? r*(dv/Math.abs(v)+di/Math.abs(i)) : NaN;
    return {v,i,dv,di,r,dr};
  }
  function calcExp6Stats(){
    const pts=exp6Pts.map(calcExp6Point).filter(c=>isFinite(c.r)&&isFinite(c.i)&&isFinite(c.v));
    const n=pts.length;
    let rBar=NaN, drBar=NaN, slope=NaN, intercept=NaN, dSlope=NaN;
    if(n>0){
      rBar=pts.reduce((s,c)=>s+c.r,0)/n;
      drBar=pts.reduce((s,c)=>s+c.dr,0)/n;
    }
    // least squares: V = slope * I + intercept  (I in mA, V in V) → slope in kΩ
    if(n>=2){
      const xs=pts.map(p=>p.i), ys=pts.map(p=>p.v);
      const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
      let sxx=0,sxy=0,syy=0;
      for(let k=0;k<n;k++){ const dx=xs[k]-mx, dy=ys[k]-my; sxx+=dx*dx; sxy+=dx*dy; syy+=dy*dy; }
      slope = sxx? sxy/sxx : NaN;
      intercept = my - slope*mx;
      // residual std error for slope uncertainty (approx)
      let ssRes=0;
      for(let k=0;k<n;k++){ const e=ys[k]-(slope*xs[k]+intercept); ssRes+=e*e; }
      const s2 = n>2 ? ssRes/(n-2) : ssRes;
      dSlope = (sxx>0) ? Math.sqrt(s2/sxx) : NaN;
      // also error from two extreme points style from جزوه if needed
    }
    const rd=parseNum(exp6Meta.rdStr), drd=autoDelta(exp6Meta.rdStr);
    return {pts,n,rBar,drBar,slope,intercept,dSlope,rd,drd};
  }
  function renderExp6Table(){
    const tb=document.getElementById('exp6TableBody'); if(!tb)return;
    let rowsHtml = `<table class="block-table"><thead><tr><th>شماره</th><th>V ± ΔV (V)</th><th>I ± ΔI (mA)</th><th>R ± ΔR (kΩ)</th></tr></thead><tbody>`;
    exp6Pts.forEach((p,i)=>{
      const c=calcExp6Point(p);
      rowsHtml += `<tr data-index="${i}">
        <td>${i+1}</td>
        <td><input type="text" inputmode="decimal" data-index="${i}" data-field="vStr" value="${p.vStr}"> <span class="auto">± ${fmtAutoDelta(c.dv)}</span></td>
        <td><input type="text" inputmode="decimal" data-index="${i}" data-field="iStr" value="${p.iStr}"> <span class="auto">± ${fmtAutoDelta(c.di)}</span></td>
        <td class="result-cell">${isFinite(c.r)?fmt(c.r):'—'} ± ${isFinite(c.dr)?fmt(c.dr):'—'}</td>
      </tr>`;
    });
    rowsHtml += `</tbody></table>`;
    tb.innerHTML = rowsHtml;

    const st=calcExp6Stats();
    const sum=document.getElementById('exp6Summary');
    if(sum){
      sum.innerHTML = `<table class="block-table">
        <thead><tr><th>R̄ ± ΔR̄ از میانگین (kΩ)</th><th>R_d ± ΔR_d اهم‌متر (kΩ)</th><th>R ± ΔR از شیب نمودار (kΩ)</th></tr></thead>
        <tbody><tr>
          <td class="result-cell">${isFinite(st.rBar)?fmt(st.rBar):'—'} ± ${isFinite(st.drBar)?fmt(st.drBar):'—'}</td>
          <td><input type="text" inputmode="decimal" id="exp6Rd" value="${exp6Meta.rdStr}"> <span class="auto">± ${fmtAutoDelta(st.drd)}</span></td>
          <td class="result-cell">${isFinite(st.slope)?fmt(st.slope):'—'} ± ${isFinite(st.dSlope)?fmt(st.dSlope):'—'}</td>
        </tr></tbody>
      </table>`;
      const rdInp=document.getElementById('exp6Rd');
      if(rdInp){ rdInp.oninput=()=>{ exp6Meta.rdStr=rdInp.value; renderExp6Cards(); }; }
    }
  }
  function renderOhmGraph(){
    const host=document.getElementById('ohmGraphSvg'); if(!host)return;
    const st=calcExp6Stats();
    const pts=st.pts;
    const W=720, H=520, padL=70, padR=30, padT=30, padB=60;
    const plotW=W-padL-padR, plotH=H-padT-padB;

    let iMax=0.6, vMax=4;
    if(pts.length){
      iMax=Math.max(...pts.map(p=>p.i))*1.15 || 0.6;
      vMax=Math.max(...pts.map(p=>p.v))*1.15 || 4;
    }
    // nice scales
    const nice=(x)=>{
      if(x<=0) return 1;
      const p=Math.pow(10, Math.floor(Math.log10(x)));
      const n=x/p;
      const m=n<=1?1:n<=2?2:n<=5?5:10;
      return m*p;
    };
    iMax=nice(iMax); vMax=nice(vMax);

    const xScale=i=> padL + (i/iMax)*plotW;
    const yScale=v=> padT + plotH - (v/vMax)*plotH;

    // grid: aim ~1cm visual ≈ about 28-36 px; we show scale text
    const nGridX=10, nGridY=10;
    let grid='';
    for(let g=0;g<=nGridX;g++){
      const x=padL+(g/nGridX)*plotW;
      grid+=`<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT+plotH}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.2:0.6}"/>`;
    }
    for(let g=0;g<=nGridY;g++){
      const y=padT+(g/nGridY)*plotH;
      grid+=`<line x1="${padL}" y1="${y}" x2="${padL+plotW}" y2="${y}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.2:0.6}"/>`;
    }

    // axes
    let axes=`<line x1="${padL}" y1="${padT+plotH}" x2="${padL+plotW}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.5"/>`;
    axes+=`<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.5"/>`;
    // ticks labels
    let labels='';
    for(let g=0;g<=nGridX;g++){
      const val=(g/nGridX)*iMax;
      const x=xScale(val);
      labels+=`<text x="${x}" y="${padT+plotH+18}" fill="#0f172a" font-size="11" text-anchor="middle" font-family="Courier New">${fmt(val, g===0?0:2)}</text>`;
    }
    for(let g=0;g<=nGridY;g++){
      const val=((nGridY-g)/nGridY)*vMax;
      const y=yScale(val);
      labels+=`<text x="${padL-8}" y="${y+4}" fill="#0f172a" font-size="11" text-anchor="end" font-family="Courier New">${fmt(val, g===nGridY?0:2)}</text>`;
    }
    labels+=`<text x="${padL+plotW/2}" y="${H-12}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle" font-family="Vazirmatn,Tahoma,sans-serif">I (mA)</text>`;
    labels+=`<text x="18" y="${padT+plotH/2}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle" transform="rotate(-90 18 ${padT+plotH/2})" font-family="Vazirmatn,Tahoma,sans-serif">V (V)</text>`;

    // fit line
    let fit='';
    if(isFinite(st.slope) && pts.length>=2){
      const i1=0, i2=iMax;
      const v1=st.slope*i1+st.intercept, v2=st.slope*i2+st.intercept;
      // clip roughly to plot
      fit=`<line x1="${xScale(i1)}" y1="${yScale(v1)}" x2="${xScale(i2)}" y2="${yScale(v2)}" stroke="#2563eb" stroke-width="2" stroke-dasharray="0"/>`;
      const eqY = padT+40;
      fit+=`<text x="${padL+plotW-10}" y="${eqY}" fill="#1e40af" font-size="13" font-weight="800" text-anchor="end" font-family="Courier New">y = ${fmt(st.slope,4)}x ${st.intercept>=0?'+':''}${fmt(st.intercept,4)}</text>`;
    }

    // scatter points ONLY (no connecting line)
    let scatter='';
    pts.forEach(p=>{
      scatter+=`<circle cx="${xScale(p.i)}" cy="${yScale(p.v)}" r="5.5" fill="#2563eb" stroke="#1e3a8a" stroke-width="1.5"/>`;
    });

    // scale box on graph
    const cmX = iMax/10; // per major grid (assuming 10 major)
    const cmY = vMax/10;
    const scaleNote=`<rect x="${padL+plotW-150}" y="${padT+plotH-55}" width="140" height="42" rx="4" fill="#fff" stroke="#64748b"/>
      <text x="${padL+plotW-80}" y="${padT+plotH-38}" fill="#0f172a" font-size="11" text-anchor="middle" font-family="Courier New">مقیاس:</text>
      <text x="${padL+plotW-80}" y="${padT+plotH-22}" fill="#0f172a" font-size="11" text-anchor="middle" font-family="Courier New">۱ خانه ≈ ${fmt(cmX,3)} mA</text>
      <text x="${padL+plotW-80}" y="${padT+plotH-8}" fill="#0f172a" font-size="11" text-anchor="middle" font-family="Courier New">۱ خانه ≈ ${fmt(cmY,3)} V</text>`;

    host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="background:#fff">
      <rect x="0" y="0" width="${W}" height="${H}" fill="#ffffff"/>
      ${grid}${axes}${labels}${fit}${scatter}${scaleNote}
    </svg>`;

    const info=document.getElementById('ohmScaleInfo');
    if(info){
      info.innerHTML=`<span class="chip">محور افقی: I (mA)</span><span class="chip">محور عمودی: V (V)</span>
        <span class="chip">نوع داده: اسکتر (پراکنده) — بدون Line</span>
        <span class="chip">فیت: حداقل مربعات خطی</span>
        <span class="chip">مقیاس X: ۱ خانه ≈ ${fmt(cmX,3)} mA</span>
        <span class="chip">مقیاس Y: ۱ خانه ≈ ${fmt(cmY,3)} V</span>`;
    }
    const box=document.getElementById('ohmFitBox');
    if(box){
      box.innerHTML=`<div class="title">نتیجه فیت خطی (روش حداقل مربعات)</div>
        <span class="eq">معادله خط: V = (${isFinite(st.slope)?fmt(st.slope,4):'—'}) · I + (${isFinite(st.intercept)?fmt(st.intercept,4):'—'})</span>
        <span class="eq">شیب = R_graph = ${isFinite(st.slope)?fmt(st.slope):'—'} kΩ</span>
        <span class="eq">ΔR از پسماند رگرسیون ≈ ${isFinite(st.dSlope)?fmt(st.dSlope):'—'} kΩ</span>
        <span class="eq">R̄ از میانگین نقاط = ${isFinite(st.rBar)?fmt(st.rBar):'—'} ± ${isFinite(st.drBar)?fmt(st.drBar):'—'} kΩ</span>
        <span class="eq">R_d از اهم‌متر = ${fmt(st.rd)} ± ${fmtAutoDelta(st.drd)} kΩ</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">نتیجه شیب: R = ${isFinite(st.slope)?fmt(st.slope):'—'} ± ${isFinite(st.dSlope)?fmt(st.dSlope):'—'} kΩ</span>`;
    }
  }
  function renderExp6Cards(){
    const w=document.getElementById('exp6Cards'); if(!w)return;
    const st=calcExp6Stats();
    w.innerHTML=`<article class="calc-card glass-inset">
      <div class="calc-head"><h3>تحقیق قانون اهم</h3><span class="chip">آزمایش ۶</span></div>
      <div class="formula-box">
        <div class="title">فرمول‌های گزارش کار — آزمایش ۶</div>
        <span class="eq">R = V / I</span>
        <span class="eq">ΔR = R (ΔV/V + ΔI/I)</span>
        <span class="eq">R̄ = (R₁ + R₂ + … + Rₙ) / n = ${isFinite(st.rBar)?fmt(st.rBar):'—'} kΩ</span>
        <span class="eq">ΔR̄ = (ΔR₁ + … + ΔRₙ) / n = ${isFinite(st.drBar)?fmt(st.drBar):'—'} kΩ</span>
        <span class="eq">از شیب نمودار (حداقل مربعات): R = ΔV/ΔI = ${isFinite(st.slope)?fmt(st.slope):'—'} kΩ</span>
        <span class="eq">R_d (اهم‌متر) = ${fmt(st.rd)} ± ${fmtAutoDelta(st.drd)} kΩ</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">R̄ ± ΔR̄ = ${isFinite(st.rBar)?fmt(st.rBar):'—'} ± ${isFinite(st.drBar)?fmt(st.drBar):'—'} kΩ  |  R_graph = ${isFinite(st.slope)?fmt(st.slope):'—'} ± ${isFinite(st.dSlope)?fmt(st.dSlope):'—'} kΩ</span>
      </div>
    </article>`;
  }
  function refreshExp6All(){ renderExp6Table(); renderOhmGraph(); renderExp6Cards(); }


  function calcExp7(){
    const r1=parseNum(exp7.r1Str), r2=parseNum(exp7.r2Str), r3=parseNum(exp7.r3Str);
    const v1=parseNum(exp7.v1Str), v2=parseNum(exp7.v2Str);
    const dr1=autoDelta(exp7.r1Str), dr2=autoDelta(exp7.r2Str), dr3=autoDelta(exp7.r3Str);
    const dv1=autoDelta(exp7.v1Str), dv2=autoDelta(exp7.v2Str);
    const i1e=parseNum(exp7.i1eStr), i2e=parseNum(exp7.i2eStr), i3e=parseNum(exp7.i3eStr);
    const di1e=autoDelta(exp7.i1eStr), di2e=autoDelta(exp7.i2eStr), di3e=autoDelta(exp7.i3eStr);
    // theoretical (R in kΩ, V in V → I in mA)
    const D = r1*r2 + r2*r3 + r3*r1;
    let i1t=NaN, i2t=NaN, i3t=NaN;
    if(D && isFinite(D)){
      i1t = (r3*v1 + r2*(v1+v2)) / D;
      i2t = (r1*v2 - r3*v1) / D;
      i3t = (r1*v2 + r2*(v1+v2)) / D;
    }
    // simple relative error on theoretical currents from ΔR, ΔV (approx)
    const di1t = (isFinite(i1t) && D) ? Math.abs(i1t)*0.02 : NaN; // placeholder small; better leave as — or use formula
    const di2t = (isFinite(i2t) && D) ? Math.abs(i2t)*0.02 : NaN;
    const di3t = (isFinite(i3t) && D) ? Math.abs(i3t)*0.02 : NaN;
    const err1 = (isFinite(i1t)&&i1t!==0&&isFinite(i1e)) ? Math.abs(i1t-i1e)/Math.abs(i1t)*100 : NaN;
    const err2 = (isFinite(i2t)&&i2t!==0&&isFinite(i2e)) ? Math.abs(i2t-i2e)/Math.abs(i2t)*100 : NaN;
    const err3 = (isFinite(i3t)&&i3t!==0&&isFinite(i3e)) ? Math.abs(i3t-i3e)/Math.abs(i3t)*100 : NaN;
    const kclExp = (isFinite(i1e)&&isFinite(i2e)&&isFinite(i3e)) ? (i1e+i2e) : NaN;
    const kclTh = (isFinite(i1t)&&isFinite(i2t)) ? (i1t+i2t) : NaN;
    return {r1,r2,r3,v1,v2,dr1,dr2,dr3,dv1,dv2,i1e,i2e,i3e,di1e,di2e,di3e,i1t,i2t,i3t,di1t,di2t,di3t,err1,err2,err3,kclExp,kclTh,D};
  }
  function renderExp7Table(){
    const tb=document.getElementById('exp7TableBody'); if(!tb)return;
    const c=calcExp7();
    const inp=(f,val)=>`<input type="text" inputmode="decimal" data-exp7-field="${f}" value="${val}">`;
    tb.innerHTML=`
      <table class="block-table">
        <thead><tr>
          <th>R₁ ± ΔR₁ (kΩ)</th><th>R₂ ± ΔR₂ (kΩ)</th><th>R₃ ± ΔR₃ (kΩ)</th>
          <th>v₁ ± Δv₁ (V)</th><th>v₂ ± Δv₂ (V)</th>
        </tr></thead>
        <tbody><tr>
          <td>${inp('r1Str',exp7.r1Str)} <span class="auto">± ${fmtAutoDelta(c.dr1)}</span></td>
          <td>${inp('r2Str',exp7.r2Str)} <span class="auto">± ${fmtAutoDelta(c.dr2)}</span></td>
          <td>${inp('r3Str',exp7.r3Str)} <span class="auto">± ${fmtAutoDelta(c.dr3)}</span></td>
          <td>${inp('v1Str',exp7.v1Str)} <span class="auto">± ${fmtAutoDelta(c.dv1)}</span></td>
          <td>${inp('v2Str',exp7.v2Str)} <span class="auto">± ${fmtAutoDelta(c.dv2)}</span></td>
        </tr></tbody>
      </table>
      <table class="block-table">
        <thead><tr>
          <th></th>
          <th>I₁ ± ΔI₁ (mA)</th><th>I₂ ± ΔI₂ (mA)</th><th>I₃ ± ΔI₃ (mA)</th>
        </tr></thead>
        <tbody>
          <tr>
            <td style="font-weight:800">مقدار نظری Th</td>
            <td class="result-cell">${isFinite(c.i1t)?fmt(c.i1t):'—'}</td>
            <td class="result-cell">${isFinite(c.i2t)?fmt(c.i2t):'—'}</td>
            <td class="result-cell">${isFinite(c.i3t)?fmt(c.i3t):'—'}</td>
          </tr>
          <tr>
            <td style="font-weight:800">مقدار تجربی Exp</td>
            <td>${inp('i1eStr',exp7.i1eStr)} <span class="auto">± ${fmtAutoDelta(c.di1e)}</span></td>
            <td>${inp('i2eStr',exp7.i2eStr)} <span class="auto">± ${fmtAutoDelta(c.di2e)}</span></td>
            <td>${inp('i3eStr',exp7.i3eStr)} <span class="auto">± ${fmtAutoDelta(c.di3e)}</span></td>
          </tr>
          <tr>
            <td style="font-weight:800">|Th−Exp|/Th × 100 (%)</td>
            <td class="result-cell">${isFinite(c.err1)?fmt(c.err1,3):'—'}</td>
            <td class="result-cell">${isFinite(c.err2)?fmt(c.err2,3):'—'}</td>
            <td class="result-cell">${isFinite(c.err3)?fmt(c.err3,3):'—'}</td>
          </tr>
        </tbody>
      </table>
      <table class="block-table">
        <thead><tr><th>بررسی KCL نظری: I₁+I₂</th><th>I₃ نظری</th><th>بررسی KCL تجربی: I₁+I₂</th><th>I₃ تجربی</th></tr></thead>
        <tbody><tr>
          <td class="result-cell">${isFinite(c.kclTh)?fmt(c.kclTh):'—'}</td>
          <td class="result-cell">${isFinite(c.i3t)?fmt(c.i3t):'—'}</td>
          <td class="result-cell">${isFinite(c.kclExp)?fmt(c.kclExp):'—'}</td>
          <td class="result-cell">${isFinite(c.i3e)?fmt(c.i3e):'—'}</td>
        </tr></tbody>
      </table>`;
  }
  function renderExp7Cards(){
    const w=document.getElementById('exp7Cards'); if(!w)return;
    const c=calcExp7();
    w.innerHTML=`<article class="calc-card glass-inset">
      <div class="calc-head"><h3>قوانین کیرشهف</h3><span class="chip">آزمایش ۷</span></div>
      <div class="formula-box">
        <div class="title">فرمول‌های گزارش کار — آزمایش ۷</div>
        <span class="eq">KCL: I₁ + I₂ = I₃</span>
        <span class="eq">KVL₁: ε₁ − I₁R₁ + I₂R₂ = 0</span>
        <span class="eq">KVL₂: −I₂R₂ + ε₂ − I₃R₃ = 0</span>
        <span class="eq">D = R₁R₂ + R₂R₃ + R₃R₁ = ${isFinite(c.D)?fmt(c.D):'—'}</span>
        <span class="eq">I₁ th = [R₃v₁ + R₂(v₁+v₂)] / D = ${isFinite(c.i1t)?fmt(c.i1t):'—'} mA</span>
        <span class="eq">I₂ th = [R₁v₂ − R₃v₁] / D = ${isFinite(c.i2t)?fmt(c.i2t):'—'} mA</span>
        <span class="eq">I₃ th = [R₁v₂ + R₂(v₁+v₂)] / D = ${isFinite(c.i3t)?fmt(c.i3t):'—'} mA</span>
        <span class="eq">درصد انحراف I₁ = ${isFinite(c.err1)?fmt(c.err1,3):'—'} % ، I₂ = ${isFinite(c.err2)?fmt(c.err2,3):'—'} % ، I₃ = ${isFinite(c.err3)?fmt(c.err3,3):'—'} %</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">I₁ th=${isFinite(c.i1t)?fmt(c.i1t):'—'} | I₂ th=${isFinite(c.i2t)?fmt(c.i2t):'—'} | I₃ th=${isFinite(c.i3t)?fmt(c.i3t):'—'} mA</span>
      </div>
    </article>`;
  }
  function refreshExp7All(){ renderExp7Table(); renderExp7Cards(); }


  function calcExp8Stats(){
    const vm=Math.abs(parseNum(exp8Meta.vmStr));
    const R=parseNum(exp8Meta.rStr);
    const dvm=autoDelta(exp8Meta.vmStr), dR=autoDelta(exp8Meta.rStr)||1;
    const cth=parseNum(exp8Meta.cthStr);
    const pts=[];
    exp8Pts.forEach(p=>{
      const t=parseNum(p.tStr), v=Math.abs(parseNum(p.vStr));
      if(isFinite(t)&&isFinite(v)) pts.push({t,v,dt:autoDelta(p.tStr),dv:autoDelta(p.vStr)});
    });
    pts.sort((a,b)=>a.t-b.t);
    // τ from Vc = 0.63 Vm by linear interpolation on sorted data
    let tau=NaN, dtau=NaN;
    const target = 0.63 * vm;
    if(isFinite(target) && pts.length>=2){
      for(let i=0;i<pts.length-1;i++){
        const v1=pts[i].v, v2=pts[i+1].v, t1=pts[i].t, t2=pts[i+1].t;
        if((v1<=target && target<=v2) || (v2<=target && target<=v1)){
          const frac = (v2!==v1) ? (target-v1)/(v2-v1) : 0;
          tau = t1 + frac*(t2-t1);
          dtau = Math.max(pts[i].dt, pts[i+1].dt) || 0.01;
          break;
        }
      }
      // if never crossed, and last point near Vm, estimate from fit
      if(!isFinite(tau) && isFinite(vm) && vm>0){
        // nonlinear: ln(1 - V/Vm) = -t/τ  →  τ = -t / ln(1-V/Vm)
        const taus=[];
        pts.forEach(p=>{
          if(p.v>0 && p.v<0.95*vm && p.t>0){
            const ratio=1-p.v/vm;
            if(ratio>0) taus.push(-p.t/Math.log(ratio));
          }
        });
        if(taus.length){
          tau = taus.reduce((s,x)=>s+x,0)/taus.length;
          dtau = Math.sqrt(taus.reduce((s,x)=>s+(x-tau)**2,0)/taus.length) || 0.01*tau;
        }
      }
    }
    // C_exp = τ/R ; τ in s, R in kΩ → C in mF; *1000 → μF
    let cexp=NaN, dcexp=NaN;
    if(isFinite(tau)&&isFinite(R)&&R!==0){
      cexp = (tau/R)*1000; // μF
      dcexp = cexp*(Math.abs(dtau)/Math.abs(tau) + Math.abs(dR)/Math.abs(R));
    }
    return {vm,R,dvm,dR,cth,pts,target,tau,dtau,cexp,dcexp};
  }
  function renderExp8Table(){
    const tb=document.getElementById('exp8TableBody'); if(!tb)return;
    let h=`<table class="block-table"><thead><tr><th>شماره</th><th>t ± Δt (s)</th><th>Vc ± ΔV (V)</th></tr></thead><tbody>`;
    exp8Pts.forEach((p,i)=>{
      const dt=autoDelta(p.tStr), dv=autoDelta(p.vStr);
      h+=`<tr>
        <td>${i+1}</td>
        <td><input type="text" inputmode="decimal" data-e8-i="${i}" data-e8-f="tStr" value="${p.tStr}"> <span class="auto">± ${fmtAutoDelta(dt)}</span></td>
        <td><input type="text" inputmode="decimal" data-e8-i="${i}" data-e8-f="vStr" value="${p.vStr}"> <span class="auto">± ${fmtAutoDelta(dv)}</span></td>
      </tr>`;
    });
    h+=`</tbody></table>`;
    tb.innerHTML=h;
    const st=calcExp8Stats();
    const sum=document.getElementById('exp8Summary');
    if(sum){
      sum.innerHTML=`<table class="block-table">
        <thead><tr><th>0.63 Vm (V)</th><th>τ ± Δτ (s)</th><th>C_exp ± ΔC (μF)</th><th>C_th (μF)</th><th>|Cth−Cexp|/Cth ×100 (%)</th></tr></thead>
        <tbody><tr>
          <td class="result-cell">${isFinite(st.target)?fmt(st.target):'—'}</td>
          <td class="result-cell">${isFinite(st.tau)?fmt(st.tau):'—'} ± ${isFinite(st.dtau)?fmt(st.dtau):'—'}</td>
          <td class="result-cell">${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'}</td>
          <td>${isFinite(st.cth)?fmt(st.cth):'—'}</td>
          <td class="result-cell">${(isFinite(st.cexp)&&isFinite(st.cth)&&st.cth)?fmt(Math.abs(st.cth-st.cexp)/Math.abs(st.cth)*100,2):'—'}</td>
        </tr></tbody>
      </table>`;
    }
    const vmD=document.getElementById('exp8VmD');
    const rd=document.getElementById('exp8RD');
    if(vmD) vmD.textContent=`± ${fmtAutoDelta(st.dvm)}`;
    if(rd) rd.textContent=`± ${fmtAutoDelta(st.dR)}`;
  }
  function renderExp8Graph(){
    const host=document.getElementById('exp8GraphSvg'); if(!host)return;
    const st=calcExp8Stats();
    const pts=st.pts;
    const W=720,H=520,padL=70,padR=30,padT=30,padB=60;
    const plotW=W-padL-padR, plotH=H-padT-padB;
    let tMax=100, vMax=6;
    if(pts.length){
      tMax=Math.max(...pts.map(p=>p.t), isFinite(st.tau)?st.tau*1.2:0)*1.1 || 100;
      vMax=Math.max(...pts.map(p=>p.v), st.vm||0)*1.15 || 6;
    }
    const nice=x=>{if(!(x>0))return 1;const p=Math.pow(10,Math.floor(Math.log10(x)));const n=x/p;return (n<=1?1:n<=2?2:n<=5?5:10)*p;};
    tMax=nice(tMax); vMax=nice(vMax);
    const xOf=t=>padL+(t/tMax)*plotW;
    const yOf=v=>padT+plotH-(v/vMax)*plotH;
    let grid='';
    for(let g=0;g<=10;g++){
      const x=padL+(g/10)*plotW, y=padT+(g/10)*plotH;
      grid+=`<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT+plotH}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.1:0.5}"/>`;
      grid+=`<line x1="${padL}" y1="${y}" x2="${padL+plotW}" y2="${y}" stroke="${g%5===0?'#94a3b8':'#e2e8f0'}" stroke-width="${g%5===0?1.1:0.5}"/>`;
    }
    let labels='';
    for(let g=0;g<=10;g++){
      const tv=(g/10)*tMax, vv=((10-g)/10)*vMax;
      labels+=`<text x="${xOf(tv)}" y="${padT+plotH+18}" fill="#0f172a" font-size="11" text-anchor="middle" font-family="Courier New">${fmt(tv,g===0?0:1)}</text>`;
      labels+=`<text x="${padL-8}" y="${yOf(vv)+4}" fill="#0f172a" font-size="11" text-anchor="end" font-family="Courier New">${fmt(vv,g===10?0:1)}</text>`;
    }
    labels+=`<text x="${padL+plotW/2}" y="${H-12}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle">t (s)</text>`;
    labels+=`<text x="18" y="${padT+plotH/2}" fill="#0f172a" font-size="14" font-weight="800" text-anchor="middle" transform="rotate(-90 18 ${padT+plotH/2})">Vc (V)</text>`;
    // theoretical curve
    let curve='';
    if(isFinite(st.tau)&&st.tau>0&&isFinite(st.vm)&&st.vm>0){
      let d='';
      for(let i=0;i<=80;i++){
        const t=(i/80)*tMax;
        const v=st.vm*(1-Math.exp(-t/st.tau));
        d+=(i===0?'M':'L')+` ${xOf(t)} ${yOf(v)} `;
      }
      curve=`<path d="${d}" fill="none" stroke="#2563eb" stroke-width="2"/>`;
    }
    // 0.63 Vm marker
    let marker='';
    if(isFinite(st.target)&&isFinite(st.tau)){
      marker=`<line x1="${xOf(st.tau)}" y1="${yOf(st.target)}" x2="${xOf(st.tau)}" y2="${padT+plotH}" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="5 3"/>
        <line x1="${padL}" y1="${yOf(st.target)}" x2="${xOf(st.tau)}" y2="${yOf(st.target)}" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="5 3"/>
        <circle cx="${xOf(st.tau)}" cy="${yOf(st.target)}" r="5" fill="#f59e0b" stroke="#b45309" stroke-width="1.5"/>
        <text x="${xOf(st.tau)+8}" y="${yOf(st.target)-8}" fill="#b45309" font-size="12" font-weight="800" font-family="Courier New">τ=${fmt(st.tau)} s</text>`;
    }
    // scatter
    let scatter='';
    pts.forEach(p=>{
      scatter+=`<circle cx="${xOf(p.t)}" cy="${yOf(p.v)}" r="5" fill="#2563eb" stroke="#1e3a8a" stroke-width="1.4"/>`;
    });
    host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="background:#fff">
      <rect width="${W}" height="${H}" fill="#fff"/>
      ${grid}
      <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.4"/>
      <line x1="${padL}" y1="${padT+plotH}" x2="${padL+plotW}" y2="${padT+plotH}" stroke="#0f172a" stroke-width="2.4"/>
      ${labels}${curve}${marker}${scatter}
    </svg>`;
    const info=document.getElementById('exp8ScaleInfo');
    if(info) info.innerHTML=`<span class="chip">محور افقی: t (s)</span><span class="chip">محور عمودی: Vc (V)</span><span class="chip">اسکتر + منحنی Vc=Vm(1−e^(−t/τ))</span><span class="chip">τ از 0.63 Vm</span>`;
    const box=document.getElementById('exp8FitBox');
    if(box) box.innerHTML=`<div class="title">نتیجه تحلیل نمودار شارژ</div>
      <span class="eq">Vm = ${isFinite(st.vm)?fmt(st.vm):'—'} V    |    0.63 Vm = ${isFinite(st.target)?fmt(st.target):'—'} V</span>
      <span class="eq">τ = ${isFinite(st.tau)?fmt(st.tau):'—'} ± ${isFinite(st.dtau)?fmt(st.dtau):'—'} s</span>
      <span class="eq">C_exp = τ/R = ${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>
      <span class="eq">C_th = ${isFinite(st.cth)?fmt(st.cth):'—'} μF</span>
      <span class="eq" style="font-weight:800;color:#61e7ff">C_exp = ${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>`;
  }
  function renderExp8Cards(){
    const w=document.getElementById('exp8Cards'); if(!w)return;
    const st=calcExp8Stats();
    w.innerHTML=`<article class="calc-card glass-inset">
      <div class="calc-head"><h3>شارژ خازن</h3><span class="chip">آزمایش ۸</span></div>
      <div class="formula-box">
        <div class="title">فرمول‌های گزارش کار — آزمایش ۸</div>
        <span class="eq">Vc = Vm (1 − e^(−t/τ))</span>
        <span class="eq">τ = RC    →    C = τ / R</span>
        <span class="eq">I = (Vm/R) e^(−t/τ)</span>
        <span class="eq">در t=τ : Vc = 0.63 Vm</span>
        <span class="eq">ΔC = C (Δτ/τ + ΔR/R)</span>
        <span class="eq" style="font-weight:800;color:#61e7ff">τ=${isFinite(st.tau)?fmt(st.tau):'—'} s  |  C_exp=${isFinite(st.cexp)?fmt(st.cexp):'—'} ± ${isFinite(st.dcexp)?fmt(st.dcexp):'—'} μF</span>
      </div>
    </article>`;
  }
  function refreshExp8All(){
    // sync meta from inputs if present
    const vm=document.getElementById('exp8Vm'), r=document.getElementById('exp8R'), ct=document.getElementById('exp8Cth');
    if(vm) exp8Meta.vmStr=vm.value;
    if(r) exp8Meta.rStr=r.value;
    if(ct) exp8Meta.cthStr=ct.value;
    renderExp8Table(); renderExp8Graph(); renderExp8Cards();
  }


  function calcExp9Stats(){
    const vm=Math.abs(parseNum(exp9Meta.vmStr));
    const R=parseNum(exp9Meta.rStr);
    const dvm=autoDelta(exp9Meta.vmStr), dR=autoDelta(exp9Meta.rStr)||1;
    const cth=parseNum(exp9Meta.cthStr);
    const pts=[];
    exp9Pts.forEach(p=>{
      const t=parseNum(p.tStr), v=Math.abs(parseNum(p.vStr));
      if(isFinite(t)&&isFinite(v)) pts.push({t,v,dt:autoDelta(p.tStr),dv:autoDelta(p.vStr)});
    });
    pts.sort((a,b)=>a.t-b.t);
    // τ at Vc = 0.37 Vm
    let tau=NaN, dtau=NaN;
    const target = 0.37 * vm;
    if(isFinite(target) && pts.length>=2){
      for(let i=0;i<pts.length-1;i++){
        const v1=pts[i].v, v2=pts[i+1].v, t1=pts[i].t, t2=pts[i+1].t;
        if((v1>=target && target>=v2) || (v2>=target && target>=v1)){
          const frac = (v2!==v1) ? (target-v1)/(v2-v1) : 0;
          tau = t1 + frac*(t2-t1);
          dtau = Math.max(pts[i].dt, pts[i+1].dt) || 0.01;
          break;
        }
      }
      if(!isFinite(tau) && isFinite(vm) && vm>0){
        const taus=[];
        pts.forEach(p=>{
          if(p.v>0 && p.v<0.98*vm && p.t>0){
            const ratio=p.v/vm;
            if(ratio>0) taus.push(-p.t/Math.log(ratio));
          }
        });
        if(taus.length){
          tau = taus.reduce((s,x)=>s+x,0)/taus.length;
          dtau = Math.sqrt(taus.reduce((s,x)=>s+(x-tau)**2,0)/taus.length) || 0.01*tau;
        }
      }
    }
    let cexp=NaN, dcexp=NaN;
    if(isFinite(tau)&&isFinite(R)&&R!==0){
      cexp = (tau/R)*1000; // μF
      dcexp = cexp*(Math.abs(dtau)/Math.abs(tau) + Math.abs(dR)/Math.abs(R));
    }
    return {vm,R,dvm,dR,cth,pts,target,tau,dtau,cexp,dcexp};
  }
