          <circle cx="580" cy="300" r="4" fill="#fff"/><circle cx="80" cy="300" r="4" fill="#fff"/>
          <circle cx="80" cy="210" r="4" fill="#fff"/><circle cx="500" cy="210" r="4" fill="#fff"/><circle cx="500" cy="300" r="4" fill="#fff"/>
