      </table>
      <table class="block-table">
        <thead><tr><th>I₁ ± ΔI₁ (A)</th><th>I₂ ± ΔI₂ (A)</th><th>I<sub>p</sub> ± ΔI<sub>p</sub> (A)</th></tr></thead>
        <tbody><tr>
