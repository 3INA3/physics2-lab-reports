    <section class="panel glass print-resistors">
      <div class="section-head"><div><h2>وسایل و انتخاب مقاومت — آزمایش ۶</h2><div class="hint">مقاومت رنگی، Breadboard، آوومتر ×۲، منبع تغذیه، رئوستا</div></div></div>
      <div class="chips" style="margin-bottom:14px">
        <span class="chip">مقاومت رنگی</span><span class="chip">رئوستا</span><span class="chip">آوومتر ×۲</span><span class="chip">منبع DC</span><span class="chip">Breadboard</span>
      </div>
