            <path d="M-32 0 L-24 -8 L-16 8 L-8 -8 L0 8 L8 -8 L16 8 L24 -8 L32 0" fill="none" stroke="#5eead4" stroke-width="2" stroke-linejoin="round"/>
            <circle cx="0" cy="0" r="5" fill="#5eead4"/>
          </g>
