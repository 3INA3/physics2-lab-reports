          <text x="470" y="100" fill="#f6c453" font-size="12" font-weight="700" font-family="Courier New">I₂</text>
          <text x="230" y="270" fill="#f6c453" font-size="12" font-weight="700" font-family="Courier New">Iₓ</text>
          <text x="470" y="270" fill="#f6c453" font-size="12" font-weight="700" font-family="Courier New">I'</text>
          <text x="280" y="168" fill="#61e7ff" font-size="11" font-weight="700" font-family="Courier New">I_G</text>
