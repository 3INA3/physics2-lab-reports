            <line x1="185" y1="60" x2="185" y2="100" stroke="#a78bfa" stroke-width="4"/>
            <line x1="140" y1="80" x2="160" y2="80" stroke="#61e7ff" stroke-width="3"/>
            <line x1="185" y1="80" x2="210" y2="80" stroke="#61e7ff" stroke-width="3"/>
