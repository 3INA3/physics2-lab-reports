      tMax=Math.max(...pts.map(p=>p.t), isFinite(st.tau)?st.tau*1.2:0)*1.1 || 100;
      vMax=Math.max(...pts.map(p=>p.v), st.vm||0)*1.15 || 6;
    }
    const nice=x=>{if(!(x>0))return 1;const p=Math.pow(10,Math.floor(Math.log10(x)));const n=x/p;return (n<=1?1:n<=2?2:n<=5?5:10)*p;};
    tMax=nice(tMax); vMax=nice(vMax);
    const xOf=t=>padL+(t/tMax)*plotW;
    const yOf=v=>padT+plotH-(v/vMax)*plotH;
    let grid='';
    for(let g=0;g<=10;g++){
