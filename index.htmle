  <!-- ============ EXP 5: Wheatstone Bridge ============ -->
  <div class="tab-panel" id="exp5">
    <section class="panel glass print-circuit">
      <div class="section-head"><div><h2>آزمایش ۵ — شکل مدار پل وتسون (مطابق جزوه)</h2><div class="hint">لوزی با R₁، R₂، Rₓ، R' و گالوانومتر G روی قطر — دقیقاً مطابق شکل آزمایش ۵ جزوه.</div></div><div class="chips"><span class="chip">Rx = (R1/R2)·R'</span><span class="chip">I_G = 0 در تعادل</span><span class="chip">پل وتسون</span></div></div>
      <div class="circuit-illust glass-inset" style="grid-template-columns:1.5fr 1fr">
        <svg viewBox="0 0 700 420" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
          <!-- Diamond bridge -->
          <g stroke="#61e7ff" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <!-- A top to D left via R1 -->
            <path d="M 350 50 L 120 180"/>
            <!-- A top to C right via R2 -->
            <path d="M 350 50 L 580 180"/>
            <!-- D left to B bottom via Rx -->
            <path d="M 120 180 L 350 340"/>
            <!-- C right to B bottom via R' -->
            <path d="M 580 180 L 350 340"/>
            <!-- galvanometer bridge D--C -->
            <path d="M 120 180 L 580 180"/>
            <!-- battery left side vertical-ish -->
            <path d="M 350 50 L 60 50 L 60 340 L 350 340"/>
          </g>
          <!-- Node labels -->
          <circle cx="350" cy="50" r="10" fill="#0a1224" stroke="#f6c453" stroke-width="2"/>
          <text x="350" y="38" fill="#f6c453" font-size="16" font-weight="800" text-anchor="middle" font-family="Courier New">A</text>
          <circle cx="120" cy="180" r="10" fill="#0a1224" stroke="#f6c453" stroke-width="2"/>
          <text x="95" y="185" fill="#f6c453" font-size="16" font-weight="800" text-anchor="middle" font-family="Courier New">D</text>
          <circle cx="580" cy="180" r="10" fill="#0a1224" stroke="#f6c453" stroke-width="2"/>
          <text x="605" y="185" fill="#f6c453" font-size="16" font-weight="800" text-anchor="middle" font-family="Courier New">C</text>
          <circle cx="350" cy="340" r="10" fill="#0a1224" stroke="#f6c453" stroke-width="2"/>
          <text x="350" y="368" fill="#f6c453" font-size="16" font-weight="800" text-anchor="middle" font-family="Courier New">B</text>
          <!-- R1 on AD -->
          <g transform="translate(200,95) rotate(-30)">
            <rect x="-40" y="-14" width="80" height="28" rx="4" fill="#0a1224" stroke="#a78bfa" stroke-width="2.5"/>
            <path d="M-32 0 L-24 -8 L-16 8 L-8 -8 L0 8 L8 -8 L16 8 L24 -8 L32 0" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linejoin="round"/>
          </g>
          <text x="175" y="90" fill="#c4b5fd" font-size="15" font-weight="800" text-anchor="middle" font-family="Vazirmatn,Tahoma,sans-serif">R₁</text>
          <!-- R2 on AC -->
          <g transform="translate(500,95) rotate(30)">
            <rect x="-40" y="-14" width="80" height="28" rx="4" fill="#0a1224" stroke="#a78bfa" stroke-width="2.5"/>
            <path d="M-32 0 L-24 -8 L-16 8 L-8 -8 L0 8 L8 -8 L16 8 L24 -8 L32 0" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linejoin="round"/>
          </g>
          <text x="525" y="90" fill="#c4b5fd" font-size="15" font-weight="800" text-anchor="middle" font-family="Vazirmatn,Tahoma,sans-serif">R₂</text>
          <!-- Rx on DB -->
          <g transform="translate(200,280) rotate(30)">
            <rect x="-40" y="-14" width="80" height="28" rx="4" fill="#0a1224" stroke="#a78bfa" stroke-width="2.5"/>
            <path d="M-32 0 L-24 -8 L-16 8 L-8 -8 L0 8 L8 -8 L16 8 L24 -8 L32 0" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linejoin="round"/>
          </g>
          <text x="175" y="295" fill="#c4b5fd" font-size="15" font-weight="800" text-anchor="middle" font-family="Vazirmatn,Tahoma,sans-serif">Rₓ</text>
          <!-- R' variable on CB -->
