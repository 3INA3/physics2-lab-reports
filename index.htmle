          <!-- Galvanometer G -->
          <circle cx="350" cy="180" r="28" fill="#0a1224" stroke="#61e7ff" stroke-width="3"/>
          <text x="350" y="186" fill="#61e7ff" font-size="18" font-weight="800" text-anchor="middle" font-family="Courier New">G</text>
          <!-- Battery -->
          <g>
            <line x1="45" y1="180" x2="45" y2="210" stroke="#e2e8f0" stroke-width="5" stroke-linecap="round"/>
            <line x1="55" y1="188" x2="55" y2="202" stroke="#94a3b8" stroke-width="3.5" stroke-linecap="round"/>
            <line x1="65" y1="180" x2="65" y2="210" stroke="#e2e8f0" stroke-width="5" stroke-linecap="round"/>
