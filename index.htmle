            <line x1="400" y1="312" x2="400" y2="328" stroke="#94a3b8" stroke-width="3.5" stroke-linecap="round"/>
            <text x="370" y="360" fill="#e9fbff" font-size="15" font-weight="800" text-anchor="middle" font-family="Courier New">ε</text>
          </g>
          <defs><marker id="arrM" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#f6c453"/></marker></defs>
          <path d="M 110 320 L 170 320" stroke="#f6c453" stroke-width="2.5" fill="none" marker-end="url(#arrM)"/>
          <text x="140" y="312" fill="#f6c453" font-size="12" font-weight="800" text-anchor="middle" font-family="Courier New">I_E</text>
          <path d="M 175 125 L 215 125" stroke="#f6c453" stroke-width="2" fill="none" marker-end="url(#arrM)"/>
          <text x="195" y="117" fill="#f6c453" font-size="11" font-weight="800" text-anchor="middle" font-family="Courier New">I₁</text>
          <path d="M 175 205 L 215 205" stroke="#f6c453" stroke-width="2" fill="none" marker-end="url(#arrM)"/>
          <text x="195" y="197" fill="#f6c453" font-size="11" font-weight="800" text-anchor="middle" font-family="Courier New">I₂</text>
